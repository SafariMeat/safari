---
import Layout from '../components/Layout.astro';
import { getEntry } from 'astro:content';

const product = await getEntry('product', 'product');
const {
  name,
  weightMinKg,
  weightMaxKg,
  form,
  processing,
  packagingOptions,
  image,
  description,
} = product.data;
---

<Layout title="Product Specification">
  <main class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] px-4 py-10 sm:py-16">
    <div class="mx-auto w-full max-w-3xl">
      <!-- Page heading -->
      <div class="mb-8 sm:mb-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-accent)_80%,transparent)]">
          Safari Meat Exports
        </p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
          Product Specification
        </h1>
        <p class="mt-2 text-sm text-[color-mix(in_srgb,var(--color-text)_60%,transparent)]">
          We supply a single product, prepared to a consistent standard for wholesale export.
        </p>
      </div>

      <div class="overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] backdrop-blur-sm shadow-xl shadow-black/30">
        <div class="relative aspect-[16/9] overflow-hidden bg-[var(--color-bg-soft-2)]">
          <img
            src={image ?? '/goat2.png'}
            alt={name}
            class="h-full w-full object-cover"
          />
        </div>

        <div class="p-6 sm:p-8">
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-[var(--color-text)]">
            {name}
          </h2>
          {description && (
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-[color-mix(in_srgb,var(--color-text)_75%,transparent)]">
              {description}
            </p>
          )}

          <dl class="mt-8 grid gap-6 border-t border-dashed border-[color-mix(in_srgb,var(--color-text)_12%,transparent)] pt-6 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_50%,transparent)]">
                Typical weight
              </dt>
              <dd class="mt-1 text-base font-medium text-[var(--color-text)]">
                {weightMinKg}–{weightMaxKg} kg
              </dd>
            </div>

            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_50%,transparent)]">
                Form
              </dt>
              <dd class="mt-1 text-base font-medium text-[var(--color-text)]">
                {form}
              </dd>
            </div>

            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_50%,transparent)]">
                Processing
              </dt>
              <dd class="mt-1 text-base font-medium text-[var(--color-text)]">
                {processing}
              </dd>
            </div>

            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_50%,transparent)]">
                Packaging
              </dt>
              <dd class="mt-1 text-base font-medium text-[var(--color-text)]">
                {packagingOptions.join(' or ')}
              </dd>
            </div>
          </dl>

          <div class="mt-8 flex flex-wrap gap-3 border-t border-dashed border-[color-mix(in_srgb,var(--color-text)_12%,transparent)] pt-6">
            <a
              href="/quote"
              class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[var(--color-accent-contrast)] transition hover:brightness-110"
            >
              Request a Quote
            </a>
            <a
              href="/about"
              class="inline-flex items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--color-text)_20%,transparent)] px-6 py-3 text-sm font-semibold text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)]"
            >
              Export Readiness
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
