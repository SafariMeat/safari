---
import Layout from '../components/Layout.astro';
import { getEntry } from 'astro:content';

const quote = await getEntry('quote', 'quote');
const contact = await getEntry('contact', 'contact');
---

<Layout title={quote.data.heading}>
  <main
    data-whatsapp-number={contact.data.whatsapp}
    data-contact-email={contact.data.email}
    class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] px-4 py-10 sm:py-16"
  >
    <div class="mx-auto w-full max-w-3xl">
      <!-- Page heading -->
      <div class="mb-8 sm:mb-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-accent)_80%,transparent)]">
          Safari Meat Exports
        </p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
          {quote.data.heading}
        </h1>
        <p class="mt-2 text-sm text-[color-mix(in_srgb,var(--color-text)_60%,transparent)]">
          Tell us what you need and we'll get back to you with a tailored quotation.
        </p>
      </div>

      <form
        id="quote-form"
        name="quote"
        data-netlify="true"
        class="rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] backdrop-blur-sm shadow-xl shadow-black/30 p-5 sm:p-8 space-y-8"
      >
        <input type="hidden" name="form-name" value="quote" />

        <!-- Contact details -->
        <fieldset class="border-0 p-0">
          <legend class="mb-4 text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-accent)_80%,transparent)]">
            Your Details
          </legend>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Full name
              </span>
              <input
                type="text"
                name="name"
                minlength="2"
                required
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="Jane Doe"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Company
              </span>
              <input
                type="text"
                name="company"
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="Company name (optional)"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Country
              </span>
              <input
                type="text"
                name="country"
                minlength="2"
                required
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="e.g. United Arab Emirates"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Email
              </span>
              <input
                type="email"
                name="email"
                required
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="jane@example.com"
              />
            </label>

            <label class="block sm:col-span-2">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Phone / WhatsApp
              </span>
              <input
                type="tel"
                name="phone"
                required
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="+254 7XX XXX XXX"
              />
            </label>
          </div>
        </fieldset>

        <!-- Order details -->
        <fieldset class="border-0 p-0">
          <legend class="mb-4 text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-accent)_80%,transparent)]">
            Order Details
          </legend>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Product
              </span>
              <input
                type="text"
                name="product"
                required
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="e.g. Goat meat, whole carcass"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Weight
              </span>
              <input
                type="text"
                name="weight"
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="e.g. 20kg per unit (optional)"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Quantity
              </span>
              <input
                type="text"
                name="quantity"
                required
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="e.g. 2 tonnes"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Order frequency
              </span>
              <input
                type="text"
                name="frequency"
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="e.g. Monthly (optional)"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Destination
              </span>
              <input
                type="text"
                name="destination"
                minlength="2"
                required
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="Port or city of delivery"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                Incoterm
              </span>
              <input
                type="text"
                name="incoterm"
                class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
                placeholder="e.g. FOB, CIF (optional)"
              />
            </label>
          </div>

          <label class="mt-5 block">
            <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              Additional requirements
            </span>
            <textarea
              name="requirements"
              rows="4"
              class="w-full resize-none rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
              placeholder="Cuts, packaging, certifications needed, etc."
            ></textarea>
          </label>
        </fieldset>

        <!-- Two send options -->
        <div class="grid gap-3 sm:grid-cols-2">
          <button
            type="submit"
            data-channel="whatsapp"
            class="w-full rounded-lg bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-900/30 transition hover:bg-emerald-500 active:scale-[0.98]"
          >
            Send via WhatsApp
          </button>
          <button
            type="button"
            data-channel="email"
            class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_20%,transparent)] bg-transparent px-4 py-3 text-sm font-semibold text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)] active:scale-[0.98]"
          >
            Send via Email
          </button>
        </div>
      </form>

      <p id="quote-status" role="status" class="mt-4 text-center text-sm text-[var(--color-accent)]"></p>
    </div>
  </main>
</Layout>

<script>
  import { isValidText } from '../lib/validate';
  import { submitLead } from '../lib/leads';

  document.addEventListener('astro:page-load', () => {
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  if (!form) return;
  const main = document.querySelector('main') as HTMLElement;
  const whatsappNumber = main.dataset.whatsappNumber ?? '';
  const contactEmail = main.dataset.contactEmail ?? '';
  const status = document.getElementById('quote-status')!;

  function getFields() {
    const formData = new FormData(form);
    return {
      name: String(formData.get('name') ?? '').trim(),
      company: String(formData.get('company') ?? '').trim(),
      country: String(formData.get('country') ?? '').trim(),
      email: String(formData.get('email') ?? '').trim(),
      phone: String(formData.get('phone') ?? '').trim(),
      product: String(formData.get('product') ?? '').trim(),
      weight: String(formData.get('weight') ?? '').trim(),
      quantity: String(formData.get('quantity') ?? '').trim(),
      frequency: String(formData.get('frequency') ?? '').trim(),
      destination: String(formData.get('destination') ?? '').trim(),
      incoterm: String(formData.get('incoterm') ?? '').trim(),
      requirements: String(formData.get('requirements') ?? '').trim(),
    };
  }

  function validate(fields: ReturnType<typeof getFields>) {
    if (!isValidText(fields.name)) {
      status.textContent = 'Please enter your full name (at least 2 characters).';
      return false;
    }
    if (!isValidText(fields.country)) {
      status.textContent = 'Please enter your country (at least 2 characters).';
      return false;
    }
    if (!isValidText(fields.destination)) {
      status.textContent = 'Please enter a valid destination (at least 2 characters).';
      return false;
    }
    return true;
  }

  function buildMessage(fields: ReturnType<typeof getFields>) {
    return [
      'Quotation Request — Safari Meat Exports',
      '',
      `Name: ${fields.name}`,
      `Company: ${fields.company}`,
      `Country: ${fields.country}`,
      `Email: ${fields.email}`,
      `Phone/WhatsApp: ${fields.phone}`,
      `Product: ${fields.product}`,
      `Weight: ${fields.weight}`,
      `Quantity: ${fields.quantity}`,
      `Order frequency: ${fields.frequency}`,
      `Destination: ${fields.destination}`,
      `Incoterm: ${fields.incoterm}`,
      `Additional requirements: ${fields.requirements}`,
    ].join('\n');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    const fields = getFields();
    if (!validate(fields)) return;

    const text = buildMessage(fields);
    const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;

    void submitLead('quote', fields);

    form.reset();
    status.textContent = 'Opening WhatsApp to send your quotation request.';
    window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
  });

  const emailButton = form.querySelector('button[data-channel="email"]') as HTMLButtonElement;
  emailButton.addEventListener('click', () => {
    const fields = getFields();
    if (!validate(fields)) return;

    const text = buildMessage(fields);
    const subject = `Quotation Request — ${fields.product || 'Safari Meat Exports'}`;
    const mailtoUrl = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;

    void submitLead('quote', fields);

    form.reset();
    status.textContent = 'Opening your email client to send your quotation request.';
    window.location.href = mailtoUrl;
  });
  });
</script>