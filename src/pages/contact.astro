---
import Layout from '../components/Layout.astro';
import { getEntry } from 'astro:content';

const contact = await getEntry('contact', 'contact');
---

<Layout title={contact.data.heading}>
  <main
    data-whatsapp-number={contact.data.whatsapp}
    data-business-email={contact.data.email}
    class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] px-4 py-10 sm:py-16"
  >
    <div class="mx-auto w-full max-w-3xl">
      <!-- Page heading -->
      <div class="mb-8 sm:mb-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-accent)_80%,transparent)]">
          Safari Meat Exports
        </p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
          {contact.data.heading}
        </h1>
        <p class="mt-2 text-sm text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
          Reach out with your enquiry and we'll get back to you as soon as we can.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-5">
        <!-- Contact details -->
        <section class="sm:col-span-2 rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] backdrop-blur-sm shadow-xl shadow-black/30 p-6 h-fit">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            Contact Details
          </h2>
          <ul class="mt-4 space-y-4 text-sm">
            <li>
              <span class="block text-xs uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">Phone</span>
              <span class="text-[var(--color-text)]">{contact.data.phone}</span>
            </li>
            <li>
              <span class="block text-xs uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">WhatsApp</span>
              <span class="text-[var(--color-text)]">{contact.data.whatsapp}</span>
            </li>
            <li>
              <span class="block text-xs uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">Email</span>
              <span class="text-[var(--color-text)]">{contact.data.email}</span>
            </li>
            <li>
              <span class="block text-xs uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">Address</span>
              <span class="text-[var(--color-text)]">{contact.data.address}</span>
            </li>
            <li>
              <span class="block text-xs uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">Hours</span>
              <span class="text-[var(--color-text)]">{contact.data.hours}</span>
            </li>
          </ul>
        </section>

        <!--
          name + data-netlify="true" + the hidden form-name input let Netlify
          detect this form at build time and log every submission to the
          Forms tab in the Netlify dashboard, giving the business a real
          message history alongside the WhatsApp handoff.
        -->
        <form
          id="contact-form"
          name="contact"
          data-netlify="true"
          class="sm:col-span-3 rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] backdrop-blur-sm shadow-xl shadow-black/30 p-5 sm:p-6 space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />

          <label class="block">
            <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              Name
            </span>
            <input
              type="text"
              name="name"
              minlength="2"
              required
              class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
              placeholder="Jane Doe"
            />
          </label>

          <label class="block">
            <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              Email
            </span>
            <input
              type="email"
              name="email"
              required
              class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
              placeholder="jane@example.com"
            />
          </label>

          <label class="block">
            <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              Message
            </span>
            <textarea
              name="message"
              required
              rows="4"
              class="w-full resize-none rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
              placeholder="Tell us what you're looking for..."
            ></textarea>
          </label>

          <fieldset class="border-0 p-0">
            <legend class="mb-2.5 text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              How would you like to send this?
            </legend>
            <div class="flex flex-col gap-3 sm:flex-row">
              <button
                type="submit"
                name="channel"
                value="whatsapp"
                class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-emerald-900/30 transition hover:bg-emerald-500 active:scale-[0.98]"
              >
                Send via WhatsApp
              </button>
              <button
                type="submit"
                name="channel"
                value="email"
                class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_4%,transparent)] px-4 py-2.5 text-sm font-semibold text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_8%,transparent)] active:scale-[0.98]"
              >
                Send via Email
              </button>
            </div>
          </fieldset>
        </form>
      </div>

      <p id="contact-status" role="status" class="mt-4 min-h-[1.25rem] text-center text-sm text-[var(--color-accent)]"></p>
    </div>
  </main>
</Layout>

<script>
  import { isValidText } from '../lib/validate';
  import { submitLead } from '../lib/leads';

  // Re-run on every client-side navigation (including back to a page already
  // visited this session) so the form binds to the freshly-swapped DOM.
  // See astro:transitions docs — a page's <script> module only executes
  // once per browser session otherwise.
  document.addEventListener('astro:page-load', () => {
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (!form) return;
  const status = document.getElementById('contact-status')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    // Which button the customer pressed — 'whatsapp' or 'email'. Falls
    // back to 'whatsapp' if the browser doesn't report submitter (older
    // Safari), matching the original single-button behavior.
    const channel =
      (e.submitter as HTMLButtonElement | null)?.value === 'email' ? 'email' : 'whatsapp';

    const formData = new FormData(form);
    const name = String(formData.get('name') ?? '').trim();
    const email = String(formData.get('email') ?? '').trim();
    const message = String(formData.get('message') ?? '').trim();

    if (!isValidText(name)) {
      status.textContent = 'Please enter your full name (at least 2 characters).';
      return;
    }

    if (!isValidText(message)) {
      status.textContent = 'Please enter a message (at least 2 characters).';
      return;
    }

    // Business contact details, editable by the admin via the Contact
    // Page entry in /admin/ (src/content/contact/contact.md).
    const main = document.querySelector('main') as HTMLElement;
    const whatsappNumber = main.dataset.whatsappNumber ?? '';
    const businessEmail = main.dataset.businessEmail ?? '';

    const text = [
      'New message from Safari Meat Exports website',
      '',
      `Name: ${name}`,
      `Email: ${email}`,
      '',
      `Message: ${message}`,
    ].join('\n');

    // Best-effort record for the business's message history — never blocks
    // whichever handoff channel the customer picked.
    void submitLead('contact', { name, email, message, channel });

    form.reset();

    if (channel === 'email') {
      const mailtoUrl = `mailto:${businessEmail}?subject=${encodeURIComponent('New message from Safari Meat Exports website')}&body=${encodeURIComponent(text)}`;
      status.textContent = 'Opening your email app to send your message.';
      window.open(mailtoUrl, '_blank', 'noopener,noreferrer');
    } else {
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
      status.textContent = 'Opening WhatsApp to send your message.';
      window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
    }
  });
  });
</script>
