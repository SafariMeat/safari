---
import Layout from '../components/Layout.astro';
import { getEntry } from 'astro:content';

const wholesale = await getEntry('wholesale', 'wholesale');
const contact = await getEntry('contact', 'contact');
---

<Layout title={wholesale.data.heading}>
  <main
    data-whatsapp-number={contact.data.whatsapp}
    data-contact-email={contact.data.email}
    class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)]"
  >

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <section class="relative overflow-hidden">

      <div class="pointer-events-none absolute -left-32 -top-32 h-72 w-72 rounded-full bg-[color-mix(in_srgb,var(--color-accent)_10%,transparent)] blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)] blur-3xl"></div>

      <div class="relative mx-auto max-w-7xl px-6 py-8 lg:px-12">

        <div class="animate-fade-up max-w-3xl pb-16 pt-8 opacity-0" style="animation-delay:0ms">

          <div class="mb-6 flex items-center gap-3 font-mono text-[10px] font-semibold uppercase tracking-[0.35em] text-[var(--color-accent)] sm:text-xs">

            <span class="h-px w-8 bg-[var(--color-accent)]"></span>

            Wholesale Enquiry

          </div>

          <h1 class="font-serif text-4xl font-semibold leading-[1.05] tracking-[-0.02em] text-[var(--color-text)] sm:text-5xl lg:text-6xl">
            {wholesale.data.heading}
          </h1>

          <p class="mt-6 max-w-xl text-base leading-7 text-[color-mix(in_srgb,var(--color-text)_65%,transparent)] sm:text-lg">
            Tell us what you need — product, quantities, destination — and
            we'll follow up with pricing and next steps over WhatsApp or email.
          </p>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- ENQUIRY FORM -->
    <!-- ========================================================= -->

    <section class="mx-auto max-w-4xl px-6 py-20 lg:px-12 lg:py-28">

      <div class="reveal overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] backdrop-blur-sm shadow-xl shadow-black/30">

        <div class="flex items-center justify-between border-b border-dashed border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_5%,transparent)] px-8 py-5 sm:px-10">

          <div class="flex items-center gap-3 font-mono text-[10px] font-semibold uppercase tracking-[0.3em] text-[var(--color-accent)] sm:text-xs">

            <span class="h-2 w-2 rotate-45 bg-[var(--color-accent)]"></span>

            Enquiry Manifest

          </div>

          <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-[color-mix(in_srgb,var(--color-text)_35%,transparent)]">
            Form 02-W
          </span>

        </div>

        <!--
          name + data-netlify="true" + the hidden form-name input let Netlify
          detect this form at build time and log every submission to the Forms
          tab in the Netlify dashboard, giving the business a real wholesale
          enquiry history alongside the WhatsApp/email handoff.
        -->
        <form id="wholesale-form" name="wholesale" data-netlify="true" class="grid gap-6 px-8 py-10 sm:grid-cols-2 sm:px-10" novalidate>
          <input type="hidden" name="form-name" value="wholesale" />

          <label class="flex flex-col gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            Company
            <input
              type="text"
              name="company"
              minlength="2"
              required
              class="rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-4 py-3 font-sans text-sm normal-case tracking-normal text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:outline-none focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
            />
            <span data-error-for="company" class="hidden font-sans text-[11px] normal-case tracking-normal text-red-400"></span>
          </label>

          <label class="flex flex-col gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            Country
            <input
              type="text"
              name="country"
              minlength="2"
              required
              class="rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-4 py-3 font-sans text-sm normal-case tracking-normal text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:outline-none focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
            />
            <span data-error-for="country" class="hidden font-sans text-[11px] normal-case tracking-normal text-red-400"></span>
          </label>

          <label class="flex flex-col gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            Product
            <input
              type="text"
              name="product"
              minlength="2"
              required
              class="rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-4 py-3 font-sans text-sm normal-case tracking-normal text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:outline-none focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
            />
            <span data-error-for="product" class="hidden font-sans text-[11px] normal-case tracking-normal text-red-400"></span>
          </label>

          <label class="flex flex-col gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            Quantity
            <input
              type="text"
              name="quantity"
              required
              class="rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-4 py-3 font-sans text-sm normal-case tracking-normal text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:outline-none focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
            />
            <span data-error-for="quantity" class="hidden font-sans text-[11px] normal-case tracking-normal text-red-400"></span>
          </label>

          <label class="flex flex-col gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            Order frequency
            <input
              type="text"
              name="frequency"
              class="rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-4 py-3 font-sans text-sm normal-case tracking-normal text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:outline-none focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
            />
          </label>

          <label class="flex flex-col gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            Destination port
            <input
              type="text"
              name="port"
              class="rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-4 py-3 font-sans text-sm normal-case tracking-normal text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:outline-none focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
            />
          </label>

          <label class="flex flex-col gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            Delivery terms
            <input
              type="text"
              name="deliveryTerms"
              class="rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-4 py-3 font-sans text-sm normal-case tracking-normal text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:outline-none focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
            />
          </label>

          <label class="flex flex-col gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.15em] text-[color-mix(in_srgb,var(--color-text)_55%,transparent)] sm:col-span-2">
            Email or phone/WhatsApp
            <input
              type="text"
              name="contactInfo"
              required
              class="rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-4 py-3 font-sans text-sm normal-case tracking-normal text-[var(--color-text)] placeholder:text-[color-mix(in_srgb,var(--color-text)_40%,transparent)] transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:outline-none focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)]"
            />
            <span data-error-for="contactInfo" class="hidden font-sans text-[11px] normal-case tracking-normal text-red-400"></span>
          </label>

          <div class="flex flex-col gap-3 sm:col-span-2">

            <button
              type="submit"
              data-action="whatsapp"
              class="group inline-flex items-center justify-center gap-3 rounded-full bg-[var(--color-accent)] px-7 py-4 text-sm font-semibold text-[var(--color-accent-contrast)] transition duration-300 hover:-translate-y-0.5 hover:brightness-110 hover:shadow-xl hover:shadow-[color-mix(in_srgb,var(--color-accent)_10%,transparent)]"
            >
              Request Wholesale Pricing via WhatsApp

              <span
                aria-hidden="true"
                class="transition-transform duration-300 group-hover:translate-x-1"
              >
                →
              </span>
            </button>

            <button
              type="button"
              data-action="email"
              class="group inline-flex items-center justify-center gap-3 rounded-full border border-[color-mix(in_srgb,var(--color-text)_20%,transparent)] bg-transparent px-7 py-4 text-sm font-semibold text-[var(--color-text)] transition duration-300 hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] hover:text-[var(--color-accent)]"
            >
              Request Wholesale Pricing via Email

              <span
                aria-hidden="true"
                class="transition-transform duration-300 group-hover:translate-x-1"
              >
                →
              </span>
            </button>

          </div>

          <p id="wholesale-status" role="status" class="font-mono text-xs leading-6 text-[var(--color-accent)] sm:col-span-2"></p>
        </form>

      </div>

    </section>

  </main>
</Layout>

<script>
  import { isValidText } from '../lib/validate';
  import { submitLead } from '../lib/leads';

  document.addEventListener('astro:page-load', () => {
  const form = document.getElementById('wholesale-form') as HTMLFormElement | null;
  if (!form) return;
  const status = document.getElementById('wholesale-status')!;
  const main = document.querySelector('main') as HTMLElement;

  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const phonePattern = /^[+\d][\d\s()-]{6,}$/;

  function isValidContactInfo(value: string): boolean {
    return emailPattern.test(value) || phonePattern.test(value);
  }

  function setFieldError(name: string, message: string) {
    const input = form.elements.namedItem(name) as HTMLInputElement | null;
    const errorEl = form.querySelector(`[data-error-for="${name}"]`);

    if (input) {
      input.classList.add('border-red-400', 'focus:border-red-400', 'focus:ring-red-400/20');
      input.setAttribute('aria-invalid', 'true');
    }

    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
  }

  function clearFieldErrors() {
    form.querySelectorAll('[data-error-for]').forEach((el) => {
      el.textContent = '';
      el.classList.add('hidden');
    });

    form.querySelectorAll('input').forEach((el) => {
      el.classList.remove('border-red-400', 'focus:border-red-400', 'focus:ring-red-400/20');
      el.removeAttribute('aria-invalid');
    });
  }

  function readFields() {
    const formData = new FormData(form);
    return {
      company: String(formData.get('company') ?? '').trim(),
      country: String(formData.get('country') ?? '').trim(),
      product: String(formData.get('product') ?? '').trim(),
      quantity: String(formData.get('quantity') ?? '').trim(),
      frequency: String(formData.get('frequency') ?? '').trim(),
      port: String(formData.get('port') ?? '').trim(),
      deliveryTerms: String(formData.get('deliveryTerms') ?? '').trim(),
      contactInfo: String(formData.get('contactInfo') ?? '').trim(),
    };
  }

  // Returns the validated fields, or null (with inline errors shown) if invalid.
  function validate(): ReturnType<typeof readFields> | null {
    clearFieldErrors();
    const fields = readFields();
    let firstInvalid: string | null = null;

    if (!isValidText(fields.company)) {
      setFieldError('company', 'Enter your company name (at least 2 characters).');
      firstInvalid ??= 'company';
    }

    if (!isValidText(fields.country)) {
      setFieldError('country', 'Enter your country (at least 2 characters).');
      firstInvalid ??= 'country';
    }

    if (!isValidText(fields.product)) {
      setFieldError('product', 'Tell us which product you need (at least 2 characters).');
      firstInvalid ??= 'product';
    }

    if (fields.quantity.length === 0) {
      setFieldError('quantity', 'Enter an approximate quantity.');
      firstInvalid ??= 'quantity';
    }

    if (fields.contactInfo.length === 0) {
      setFieldError('contactInfo', 'Enter an email address or phone/WhatsApp number.');
      firstInvalid ??= 'contactInfo';
    } else if (!isValidContactInfo(fields.contactInfo)) {
      setFieldError('contactInfo', 'Enter a valid email address or phone number.');
      firstInvalid ??= 'contactInfo';
    }

    if (firstInvalid) {
      const input = form.elements.namedItem(firstInvalid) as HTMLInputElement | null;
      input?.focus();
      status.textContent = 'Please fix the highlighted fields before continuing.';
      return null;
    }

    return fields;
  }

  function buildMessageText(fields: ReturnType<typeof readFields>) {
    return [
      'Wholesale Pricing Request — Safari Meat Exports',
      '',
      `Company: ${fields.company}`,
      `Country: ${fields.country}`,
      `Product: ${fields.product}`,
      `Quantity: ${fields.quantity}`,
      `Order frequency: ${fields.frequency}`,
      `Destination port: ${fields.port}`,
      `Delivery terms: ${fields.deliveryTerms}`,
      `Contact: ${fields.contactInfo}`,
    ].join('\n');
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    const fields = validate();
    if (!fields) return;

    const whatsappNumber = main.dataset.whatsappNumber ?? '';
    const text = buildMessageText(fields);
    const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;

    // Best-effort record for the business's wholesale-enquiry history —
    // never blocks the WhatsApp handoff if it fails.
    void submitLead('wholesale', fields);

    form.reset();
    status.textContent = 'Opening WhatsApp to send your wholesale enquiry.';
    window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
  });

  const emailButton = form.querySelector('[data-action="email"]') as HTMLButtonElement;

  emailButton.addEventListener('click', () => {
    const fields = validate();
    if (!fields) return;

    const contactEmail = main.dataset.contactEmail ?? '';
    const subject = `Wholesale Pricing Request — ${fields.company}`;
    const body = buildMessageText(fields);
    const mailtoUrl = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    // Best-effort record for the business's wholesale-enquiry history —
    // never blocks the email handoff if it fails.
    void submitLead('wholesale', fields);

    form.reset();
    status.textContent = 'Opening your email app to send your wholesale enquiry.';
    window.location.href = mailtoUrl;
  });
  });
</script>

<script>
  document.addEventListener('astro:page-load', () => {
    const revealEls = document.querySelectorAll('.reveal');

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    );

    revealEls.forEach((el) => observer.observe(el));
  });
</script>

<style>
  /*
   * Header entrance — staggered fade + rise, driven by inline animation-delay.
   */

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /*
   * Scroll reveal for the form card.
   */

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /*
   * Respect reduced-motion preferences.
   */

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-up {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
