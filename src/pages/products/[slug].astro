---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const { name, pricePerKg, unit, inStock, stockQty } = product.data;
const slug = product.slug;
// A product is only orderable when the admin's manual toggle is on AND
// there's actually stock on hand — either alone being false means no sale.
const orderable = inStock && stockQty > 0;
---

<Layout title={name}>
  <main class="min-h-screen bg-neutral-950 text-neutral-100 px-4 py-10 sm:py-16">
    <div class="mx-auto w-full max-w-3xl">
      <a
        href="/products"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-400 transition hover:text-amber-400"
      >
        &larr; All products
      </a>

      <div class="mt-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-sm shadow-xl shadow-black/30 p-6 sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">{name}</h1>
          <span
            class:list={[
              'flex-shrink-0 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide',
              orderable
                ? 'border border-emerald-500/30 bg-emerald-500/10 text-emerald-400'
                : 'border border-red-500/30 bg-red-500/10 text-red-400',
            ]}
          >
            {orderable ? 'In stock' : 'Out of stock'}
          </span>
        </div>

        <p class="mt-3 text-2xl font-semibold text-amber-400">
          Ksh {pricePerKg}
          <span class="text-base font-normal text-neutral-500">/{unit}</span>
        </p>

        <p class="mt-1 text-sm text-neutral-400">
          {orderable
            ? `${stockQty} ${unit} available`
            : 'Currently unavailable — check back soon.'}
        </p>

        <div class="prose prose-invert prose-neutral mt-6 max-w-none border-t border-white/10 pt-6 text-sm leading-relaxed prose-headings:text-white prose-a:text-amber-400 prose-strong:text-white">
          <Content />
        </div>

        <form
          id="add-to-cart-form"
          data-slug={slug}
          data-name={name}
          data-price={pricePerKg}
          data-stock={stockQty}
          class="mt-8 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-end"
        >
          <label class="block sm:w-40">
            <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-neutral-400">
              Quantity ({unit})
            </span>
            <input
              type="number"
              name="qty"
              min="1"
              step="1"
              max={orderable ? stockQty : 0}
              value={orderable ? 1 : 0}
              disabled={!orderable}
              class="w-full rounded-lg border border-white/10 bg-neutral-900/80 px-3.5 py-2.5 text-sm text-white outline-none transition focus:border-amber-500/60 focus:ring-2 focus:ring-amber-500/20 disabled:cursor-not-allowed disabled:opacity-40"
            />
          </label>
          <button
            type="submit"
            disabled={!orderable}
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-emerald-900/30 transition hover:bg-emerald-500 active:scale-[0.98] disabled:cursor-not-allowed disabled:bg-neutral-700 disabled:text-neutral-400 disabled:shadow-none disabled:active:scale-100"
          >
            Add to order
          </button>
        </form>

        <p id="add-to-cart-status" role="status" class="mt-3 min-h-[1.25rem] text-sm text-amber-400"></p>

        <a
          id="checkout-button"
          href="/order"
          hidden
          class="mt-2 inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/[0.04] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white/[0.08]"
        >
          Checkout &rarr;
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { addToCart, getCart } from '../../lib/cart';

  const form = document.getElementById('add-to-cart-form') as HTMLFormElement;
  const status = document.getElementById('add-to-cart-status');
  const checkoutButton = document.getElementById('checkout-button') as HTMLAnchorElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const stock = Math.max(0, parseInt(form.dataset.stock || '0', 10));
    const slug = form.dataset.slug!;

    if (stock <= 0) {
      if (status) status.textContent = 'Sorry, this item is currently out of stock.';
      return;
    }

    const qtyInput = form.querySelector('input[name="qty"]') as HTMLInputElement;
    const requested = Math.max(1, parseInt(qtyInput.value || '1', 10));

    // Cap by remaining stock, accounting for however much of this item is
    // already sitting in the customer's cart — the cap is on total stock,
    // not per add-to-cart click.
    const alreadyInCart = getCart()[slug]?.qty ?? 0;
    const remaining = Math.max(0, stock - alreadyInCart);

    if (remaining <= 0) {
      if (status) {
        status.textContent = `You already have the full available stock (${stock}) of this item in your order.`;
      }
      return;
    }

    const qty = Math.min(requested, remaining);

    addToCart(
      {
        slug,
        name: form.dataset.name!,
        pricePerKg: Number(form.dataset.price),
      },
      qty
    );

    if (status) {
      status.textContent =
        qty < requested
          ? `Only ${qty} ${qty === 1 ? 'unit' : 'units'} available — added ${qty} to your order.`
          : `Added ${qty} to your order.`;
    }
    checkoutButton.hidden = false;
    checkoutButton.focus();
  });
</script>