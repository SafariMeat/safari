---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const { name, pricePerKg, unit, inStock, stockQty, image } = product.data;
const slug = product.slug;
// A product is only orderable when the admin's manual toggle is on AND
// there's actually stock on hand — either alone being false means no sale.
const orderable = inStock && stockQty > 0;

// Fixed conversion rate (not live) — update this number whenever you want to refresh it
const USD_TO_KSH = 129;
const toUsd = (kshPrice: number) => (Number(kshPrice) / USD_TO_KSH).toFixed(2);
---

<Layout title={name}>
  <main class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] px-4 py-10 sm:py-16">
    <div class="mx-auto w-full max-w-3xl">
      <a
        href="/products"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-[color-mix(in_srgb,var(--color-text)_60%,transparent)] transition hover:text-[var(--color-accent)]"
      >
        &larr; All products
      </a>

      <div class="mt-6 rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] backdrop-blur-sm shadow-xl shadow-black/30 overflow-hidden">
        <img
          src={image ?? '/goat3.jpeg'}
          alt={name}
          loading="eager"
          class="h-56 w-full object-cover sm:h-72"
        />
        <div class="p-6 sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)]">{name}</h1>
          <span
            class:list={[
              'flex-shrink-0 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide',
              orderable
                ? 'border border-[color-mix(in_srgb,var(--color-success)_35%,transparent)] bg-[color-mix(in_srgb,var(--color-success)_12%,transparent)] text-[var(--color-success)]'
                : 'border border-[color-mix(in_srgb,var(--color-danger)_35%,transparent)] bg-[color-mix(in_srgb,var(--color-danger)_12%,transparent)] text-[var(--color-danger)]',
            ]}
          >
            {orderable ? 'In stock' : 'Out of stock'}
          </span>
        </div>

        <p class="mt-3 text-2xl font-semibold text-[var(--color-accent)]">
          Ksh {pricePerKg}
          <span class="text-base font-normal text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">/{unit}</span>
          <span class="text-base font-normal text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
            (${toUsd(pricePerKg)})
          </span>
        </p>

        <p class="mt-1 text-sm text-[color-mix(in_srgb,var(--color-text)_60%,transparent)]">
          {orderable
            ? `${stockQty} ${unit} available`
            : 'Currently unavailable — check back soon.'}
        </p>

        <div class="prose prose-invert prose-neutral mt-6 max-w-none border-t border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] pt-6 text-sm leading-relaxed prose-headings:text-[var(--color-text)] prose-a:text-[var(--color-accent)] prose-strong:text-[var(--color-text)]">
          <Content />
        </div>

        <form
          id="add-to-cart-form"
          data-slug={slug}
          data-name={name}
          data-price={pricePerKg}
          data-stock={stockQty}
          data-image={image ?? '/goat.jfif'}
          class="mt-8 flex flex-col gap-4 border-t border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] pt-6 sm:flex-row sm:items-end"
        >
          <label class="block sm:w-40">
            <span class="mb-1.5 block text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              Quantity ({unit})
            </span>
            <input
              type="number"
              name="qty"
              min="1"
              step="1"
              max={orderable ? stockQty : 0}
              value={orderable ? 1 : 0}
              disabled={!orderable}
              class="w-full rounded-lg border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg-soft)_80%,transparent)] px-3.5 py-2.5 text-sm text-[var(--color-text)] outline-none transition focus:border-[color-mix(in_srgb,var(--color-accent)_60%,transparent)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent)_20%,transparent)] disabled:cursor-not-allowed disabled:opacity-40"
            />
          </label>
          <button
            type="submit"
            disabled={!orderable}
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-[var(--color-success)] px-5 py-2.5 text-sm font-semibold text-[var(--color-success-contrast)] shadow-lg shadow-[color-mix(in_srgb,var(--color-success)_35%,transparent)] transition hover:bg-[var(--color-success-hover)] active:scale-[0.98] disabled:cursor-not-allowed disabled:bg-[var(--color-bg-soft-2)] disabled:text-[color-mix(in_srgb,var(--color-text)_45%,transparent)] disabled:shadow-none disabled:active:scale-100"
          >
            Add to order
          </button>
        </form>

        <p id="add-to-cart-status" role="status" class="mt-3 min-h-[1.25rem] text-sm text-[var(--color-accent)]"></p>

        <a
          id="checkout-button"
          href="/order"
          hidden
          class="mt-2 inline-flex items-center gap-1.5 rounded-lg border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_4%,transparent)] px-4 py-2.5 text-sm font-semibold text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_8%,transparent)]"
        >
          Checkout &rarr;
        </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { addToCart, getCart } from '../../lib/cart';

  document.addEventListener('astro:page-load', () => {
  const form = document.getElementById('add-to-cart-form') as HTMLFormElement | null;
  const status = document.getElementById('add-to-cart-status');
  const checkoutButton = document.getElementById('checkout-button') as HTMLAnchorElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const stock = Math.max(0, parseInt(form.dataset.stock || '0', 10));
    const slug = form.dataset.slug!;

    if (stock <= 0) {
      if (status) status.textContent = 'Sorry, this item is currently out of stock.';
      return;
    }

    const qtyInput = form.querySelector('input[name="qty"]') as HTMLInputElement;
    const requested = Math.max(1, parseInt(qtyInput.value || '1', 10));

    // Cap by remaining stock, accounting for however much of this item is
    // already sitting in the customer's cart — the cap is on total stock,
    // not per add-to-cart click.
    const alreadyInCart = getCart()[slug]?.qty ?? 0;
    const remaining = Math.max(0, stock - alreadyInCart);

    if (remaining <= 0) {
      if (status) {
        status.textContent = `You already have the full available stock (${stock}) of this item in your order.`;
      }
      return;
    }

    const qty = Math.min(requested, remaining);

    addToCart(
      {
        slug,
        name: form.dataset.name!,
        pricePerKg: Number(form.dataset.price),
        image: form.dataset.image,
      },
      qty
    );

    if (status) {
      status.textContent =
        qty < requested
          ? `Only ${qty} ${qty === 1 ? 'unit' : 'units'} available — added ${qty} to your order.`
          : `Added ${qty} to your order.`;
    }
    checkoutButton.hidden = false;
    checkoutButton.focus();
  });
  });
</script>
