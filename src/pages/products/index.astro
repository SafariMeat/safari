---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('products');

// Fixed conversion rate (not live) — update this number whenever you want to refresh it
const USD_TO_KSH = 129;
const toUsd = (kshPrice: number) => (Number(kshPrice) / USD_TO_KSH).toFixed(2);
---

<Layout title="Products">
  <main class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] px-4 py-10 sm:py-16">
    <div class="mx-auto w-full max-w-6xl">
      <!-- Page heading -->
      <div class="mb-8 sm:mb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-accent)_80%,transparent)]">
          Safari Meat Exports
        </p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
          Products
        </h1>
        <p class="mt-2 text-sm text-[color-mix(in_srgb,var(--color-text)_60%,transparent)]">
          Quality East African goat meat, sourced and prepared to export standard.
        </p>
      </div>

      {products.length === 0 ? (
        <p class="rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] px-5 py-10 text-center text-sm text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
          No products available right now.
        </p>
      ) : (
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((p) => (
            <li>
              <a
                href={`/products/${p.slug}`}
                class="group flex h-full flex-col justify-between overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] backdrop-blur-sm shadow-xl shadow-black/30 transition hover:border-[color-mix(in_srgb,var(--color-accent)_30%,transparent)] hover:bg-[color-mix(in_srgb,var(--color-text)_5%,transparent)]"
              >
                <img
                  src={p.data.image ?? '/goat3.jpeg'}
                  alt={p.data.name}
                  loading="lazy"
                  class="h-40 w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                />
                <div class="flex flex-1 flex-col justify-between p-5">
                <div>
                  <div class="flex items-start justify-between gap-3">
                    <h2 class="text-lg font-semibold text-[var(--color-text)] transition group-hover:text-[var(--color-accent)]">
                      {p.data.name}
                    </h2>
                    {!p.data.inStock && (
                      <span class="flex-shrink-0 rounded-full border border-[color-mix(in_srgb,var(--color-danger)_35%,transparent)] bg-[color-mix(in_srgb,var(--color-danger)_12%,transparent)] px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-[var(--color-danger)]">
                        Out of stock
                      </span>
                    )}
                  </div>
                  <p class="mt-1.5 text-xs font-medium uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
                    {p.data.category}
                  </p>
                </div>

                <div class="mt-6 flex items-end justify-between">
                  <p class="text-xl font-semibold text-[var(--color-accent)]">
                    Ksh {p.data.pricePerKg}
                    <span class="text-sm font-normal text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">/{p.data.unit}</span>
                    <span class="ml-1 text-sm font-normal text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
                      (${toUsd(p.data.pricePerKg)})
                    </span>
                  </p>
                  <span class="text-sm font-medium text-[color-mix(in_srgb,var(--color-text)_60%,transparent)] transition group-hover:text-[var(--color-text)]">
                    View &rarr;
                  </span>
                </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</Layout>
