---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('products');
---

<Layout title="Products">
  <main class="min-h-screen bg-neutral-950 text-neutral-100 px-4 py-10 sm:py-16">
    <div class="mx-auto w-full max-w-6xl">
      <!-- Page heading -->
      <div class="mb-8 sm:mb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-500/80">
          Safari Meat Exports
        </p>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-white">
          Products
        </h1>
        <p class="mt-2 text-sm text-neutral-400">
          Quality East African goat meat, sourced and prepared to export standard.
        </p>
      </div>

      {products.length === 0 ? (
        <p class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-10 text-center text-sm text-neutral-500">
          No products available right now.
        </p>
      ) : (
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((p) => (
            <li>
              <a
                href={`/products/${p.slug}`}
                class="group flex h-full flex-col justify-between rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-sm p-5 shadow-xl shadow-black/30 transition hover:border-amber-500/30 hover:bg-white/[0.05]"
              >
                <div>
                  <div class="flex items-start justify-between gap-3">
                    <h2 class="text-lg font-semibold text-white transition group-hover:text-amber-400">
                      {p.data.name}
                    </h2>
                    {!p.data.inStock && (
                      <span class="flex-shrink-0 rounded-full border border-red-500/30 bg-red-500/10 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-red-400">
                        Out of stock
                      </span>
                    )}
                  </div>
                  <p class="mt-1.5 text-xs font-medium uppercase tracking-wide text-neutral-500">
                    {p.data.category}
                  </p>
                </div>

                <div class="mt-6 flex items-end justify-between">
                  <p class="text-xl font-semibold text-amber-400">
                    Ksh {p.data.pricePerKg}
                    <span class="text-sm font-normal text-neutral-500">/{p.data.unit}</span>
                  </p>
                  <span class="text-sm font-medium text-neutral-400 transition group-hover:text-white">
                    View &rarr;
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</Layout>