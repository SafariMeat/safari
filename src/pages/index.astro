---
import Layout from '../components/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
const products = await getCollection('products');

const contact = await getEntry('contact', 'contact');
const whatsappUrl = `https://wa.me/${contact.data.whatsapp}`;
---

<Layout title={home.data.heading}>
  <main class="bg-stone-50 text-stone-900">

    <!-- HERO -->
    <section class="relative overflow-hidden bg-stone-900 text-stone-50">
      <div class="absolute inset-0">
        <img
          src="/images/hero-goat-meat.jpg"
          alt="Premium export-ready goat meat, packaged and chilled"
          class="h-full w-full object-cover opacity-40"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-stone-900 via-stone-900/70 to-stone-900/20"></div>
      </div>

      <div class="relative mx-auto max-w-6xl px-6 py-28 sm:py-36 lg:px-8">
        <span class="inline-block rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1 text-xs font-medium uppercase tracking-widest text-emerald-400">
          East African Meat Exporters
        </span>

        <h1 class="mt-6 max-w-3xl text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
          {home.data.heading}
        </h1>

        <p class="mt-6 max-w-2xl text-lg text-stone-300">
          Premium, export-ready goat meat supplied to international wholesale buyers —
          quality-controlled sourcing, professional packaging and cold-chain handling
          from East Africa to your market.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          
            href="/quote"
            class="rounded-md bg-emerald-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-900/30 transition hover:bg-emerald-500"
          >
            Request a Quotation
          </a>
          
            href="/products"
            class="rounded-md border border-stone-400/40 px-6 py-3 text-sm font-semibold text-stone-100 transition hover:border-stone-200 hover:bg-stone-50/5"
          >
            View Our Products
          </a>
          
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400 transition hover:text-emerald-300"
          >
            WhatsApp Us
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-widest text-emerald-700">
            Our Products
          </h2>
          <p class="mt-2 text-2xl font-semibold text-stone-900 sm:text-3xl">
            Premium Goat Meat, Export Ready
          </p>
        </div>
        
          href="/products"
          class="text-sm font-semibold text-emerald-700 transition hover:text-emerald-600"
        >
          View all products &rarr;
        </a>
      </div>

      <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <li class="group relative overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
            <a href={`/products/${p.slug}`} class="block">
              <div class="aspect-[4/3] overflow-hidden bg-stone-100">
                <img
                  src={p.data.image ?? '/images/product-placeholder.jpg'}
                  alt={p.data.name}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
                {!p.data.inStock && (
                  <span class="absolute left-4 top-4 rounded-full bg-stone-900/80 px-3 py-1 text-xs font-medium text-white">
                    Out of Stock
                  </span>
                )}
              </div>

              <div class="p-5">
                <h3 class="text-lg font-semibold text-stone-900">{p.data.name}</h3>
                <p class="mt-1 text-sm text-stone-500">
                  Ksh {p.data.pricePerKg} / {p.data.unit}
                </p>
                <span class="mt-4 inline-flex items-center text-sm font-semibold text-emerald-700 transition group-hover:text-emerald-600">
                  View details
                  <span class="ml-1 transition group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- FINAL CTA -->
    <section class="border-t border-stone-200 bg-stone-100">
      <div class="mx-auto max-w-6xl px-6 py-20 text-center lg:px-8">
        <h2 class="text-2xl font-semibold text-stone-900 sm:text-3xl">
          Looking for a Reliable East African Goat Meat Supplier?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-stone-600">
          Request product specifications, pricing, quantities and shipping information —
          our team responds promptly to wholesale enquiries.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          
            href="/quote"
            class="rounded-md bg-emerald-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-900/10 transition hover:bg-emerald-500"
          >
            Request a Quote
          </a>
          
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md border border-stone-300 px-6 py-3 text-sm font-semibold text-stone-800 transition hover:border-stone-400 hover:bg-white"
          >
            Contact Sales
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>