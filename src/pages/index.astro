---
import Layout from '../components/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
const products = await getCollection('products');

const contact = await getEntry('contact', 'contact');
const whatsappUrl = `https://wa.me/${contact.data.whatsapp}`;
---

<Layout title={home.data.heading}>
  <main class="bg-stone-50">
    <!-- Hero -->
    <section class="bg-emerald-950 px-6 py-20 sm:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-50 sm:text-5xl">
          {home.data.heading}
        </h1>
        <p class="mt-4 text-lg text-emerald-100/80">
          Whole carcasses, sourced daily. Order for delivery, or talk to us directly.
        </p>

        <nav class="mt-8 flex flex-wrap items-center justify-center gap-4">
          
            href="/quote"
            class="rounded-full bg-amber-500 px-6 py-3 text-sm font-semibold text-emerald-950 transition hover:bg-amber-400"
          >
            Request a Quotation
          </a>
          
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-emerald-100/30 px-6 py-3 text-sm font-semibold text-stone-50 transition hover:border-emerald-100/60 hover:bg-emerald-900"
          >
            WhatsApp Us
          </a>
          
            href="/products"
            class="text-sm font-semibold text-amber-400 underline-offset-4 transition hover:text-amber-300 hover:underline"
          >
            View our products →
          </a>
        </nav>
      </div>
    </section>

    <!-- Products -->
    <section class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="font-serif text-2xl font-semibold text-emerald-950">Available now</h2>

      <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <li class="group rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <a href={`/products/${p.slug}`} class="flex h-full flex-col justify-between">
              <div>
                <span class="font-serif text-lg font-semibold text-emerald-950 group-hover:text-emerald-800">
                  {p.data.name}
                </span>
                {!p.data.inStock && (
                  <span class="ml-2 inline-block rounded-full bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-500">
                    Out of stock
                  </span>
                )}
              </div>
              <p class="mt-3 text-sm font-medium text-amber-700">
                Ksh {p.data.pricePerKg} / {p.data.unit}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>