---
import Layout from '../components/Layout.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
const product = await getEntry('product', 'product');
const contact = await getEntry('contact', 'contact');

const whatsappUrl = `https://wa.me/${contact.data.whatsapp}`;

const {
  heading,
  heroEyebrow,
  heroHeadingLine1,
  heroHeadingLine2,
  heroDescription,
  heroCtaPrimaryLabel,
  heroCtaSecondaryLabel,
  heroCtaWhatsappLabel,
  heroLedger,
  tickerRow1,
  tickerRow2,
  productsEyebrow,
  productsHeadingLine1,
  productsHeadingLine2,
  productsDescription,
  productsCtaLabel,
  whySupplyEyebrow,
  whySupplyHeadingLine1,
  whySupplyHeadingLine2,
  whySupplyCards,
  ctaEyebrow,
  ctaHeading,
  ctaDescription,
  ctaPrimaryLabel,
  ctaSecondaryLabel,
} = home.data;
---

<Layout title={heading}>
  <main class="bg-[var(--color-bg)] text-[var(--color-text)]">

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="relative min-h-[60vh] overflow-hidden bg-[var(--color-bg)] text-[var(--color-text)] lg:min-h-[42vh]">

      <img
        src="/goat2.png"
        alt="Premium export-ready goat meat"
        class="absolute inset-0 h-full w-full object-cover opacity-[0.12]"
      />

      <!-- Ambient hero animation — a sleek, modern impression of global
           export logistics: soft drifting mesh-gradient light, a fine
           parallax dot-grid, and a handful of animated trade-route lines
           with light pulses travelling along them. Entirely abstract and
           kept low-contrast so it never competes with the type on top. -->
      <div class="hero-ambient pointer-events-none absolute inset-0 overflow-hidden" data-hero-ambient aria-hidden="true">

        <div class="hero-ambient-scrim absolute inset-0"></div>

        <!-- drifting mesh-gradient glows -->
        <div class="hero-amb-mesh absolute inset-0">
          <span class="hero-amb-glow hero-amb-glow--a"></span>
          <span class="hero-amb-glow hero-amb-glow--b"></span>
          <span class="hero-amb-glow hero-amb-glow--c"></span>
        </div>

        <div class="hero-ambient-vignette absolute inset-0"></div>

        <svg
          class="hero-ambient-svg absolute inset-0 h-full w-full"
          viewBox="0 0 1600 900"
          preserveAspectRatio="xMidYMid slice"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <pattern id="dotGrid" width="42" height="42" patternUnits="userSpaceOnUse">
              <circle cx="1.4" cy="1.4" r="1.4" fill="#DDA556" fill-opacity="0.35" />
            </pattern>

            <radialGradient id="gridFade" cx="50%" cy="38%" r="65%">
              <stop offset="0%" stop-color="#000" stop-opacity="1" />
              <stop offset="100%" stop-color="#000" stop-opacity="0" />
            </radialGradient>

            <mask id="gridMask">
              <rect x="0" y="0" width="1600" height="900" fill="url(#gridFade)" />
            </mask>

            <linearGradient id="routeGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#C17F2E" stop-opacity="0" />
              <stop offset="50%" stop-color="#DDA556" stop-opacity="0.7" />
              <stop offset="100%" stop-color="#C17F2E" stop-opacity="0" />
            </linearGradient>

            <filter id="dotGlow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur stdDeviation="3" />
            </filter>
          </defs>

          <!-- fine dot-grid, fading out toward the edges -->
          <rect x="0" y="0" width="1600" height="900" fill="url(#dotGrid)" mask="url(#gridMask)" />

          <!-- abstract trade-route lines, sweeping across the hero -->
          <g class="hero-amb-route hero-amb-route--a" fill="none" stroke="url(#routeGrad)" stroke-width="1.4">
            <path d="M-100,620 C320,540 520,700 860,560 C1140,440 1340,520 1700,360" />
          </g>
          <g class="hero-amb-route hero-amb-route--b" fill="none" stroke="url(#routeGrad)" stroke-width="1.4">
            <path d="M-100,260 C260,320 480,180 820,260 C1120,332 1360,220 1700,300" />
          </g>
          <g class="hero-amb-route hero-amb-route--c" fill="none" stroke="url(#routeGrad)" stroke-width="1" opacity="0.6">
            <path d="M-100,440 C300,480 620,380 980,430 C1260,470 1440,400 1700,460" />
          </g>

          <!-- light pulses travelling along each route -->
          <circle class="hero-amb-pulse hero-amb-pulse--a" r="4" fill="#F2EAD9" filter="url(#dotGlow)">
            <animateMotion dur="9s" repeatCount="indefinite" rotate="auto"
              path="M-100,620 C320,540 520,700 860,560 C1140,440 1340,520 1700,360" />
          </circle>
          <circle class="hero-amb-pulse hero-amb-pulse--b" r="3.5" fill="#DDA556" filter="url(#dotGlow)">
            <animateMotion dur="12s" repeatCount="indefinite" begin="-3s" rotate="auto"
              path="M-100,260 C260,320 480,180 820,260 C1120,332 1360,220 1700,300" />
          </circle>
          <circle class="hero-amb-pulse hero-amb-pulse--c" r="3" fill="#F2EAD9" filter="url(#dotGlow)" opacity="0.8">
            <animateMotion dur="14s" repeatCount="indefinite" begin="-6s" rotate="auto"
              path="M-100,440 C300,480 620,380 980,430 C1260,470 1440,400 1700,460" />
          </circle>
        </svg>

        <!-- slow-drifting particles -->
        <div class="hero-amb-particles absolute inset-0">
          <span class="hero-amb-p" style="--x:8%; --size:2.5px; --dur:16s; --delay:0s;"></span>
          <span class="hero-amb-p" style="--x:22%; --size:2px; --dur:19s; --delay:2.4s;"></span>
          <span class="hero-amb-p" style="--x:37%; --size:3px; --dur:14s; --delay:1.1s;"></span>
          <span class="hero-amb-p" style="--x:51%; --size:2px; --dur:21s; --delay:3.6s;"></span>
          <span class="hero-amb-p" style="--x:64%; --size:2.5px; --dur:17s; --delay:0.8s;"></span>
          <span class="hero-amb-p" style="--x:73%; --size:2px; --dur:20s; --delay:2.9s;"></span>
          <span class="hero-amb-p" style="--x:85%; --size:2.5px; --dur:15s; --delay:1.7s;"></span>
          <span class="hero-amb-p" style="--x:93%; --size:2px; --dur:18s; --delay:0.3s;"></span>
        </div>

      </div>

      <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg)] via-[color-mix(in_srgb,var(--color-bg)_80%,transparent)] to-[color-mix(in_srgb,var(--color-bg)_40%,transparent)]"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg)] via-transparent to-transparent"></div>

      <!-- signature certification stamp -->
      <div class="stamp-spin pointer-events-none absolute -left-6 top-20 hidden h-24 w-24 text-[#C17F2E]/70 sm:block lg:-left-8 lg:h-32 lg:w-32">
        <svg viewBox="0 0 160 160" class="h-full w-full">
          <defs>
            <path id="stampRing" d="M 80,80 m -62,0 a 62,62 0 1,1 124,0 a 62,62 0 1,1 -124,0" />
          </defs>
          <circle cx="80" cy="80" r="74" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 5" />
          <circle cx="80" cy="80" r="50" fill="none" stroke="currentColor" stroke-width="1" />
          <text font-size="8.5" letter-spacing="2.5" fill="currentColor" style="font-family: ui-monospace, monospace;">
            <textPath href="#stampRing" startOffset="2%">CERTIFIED &#8226; EXPORT GRADE &#8226; CERTIFIED &#8226; EXPORT GRADE &#8226;</textPath>
          </text>
          <text x="80" y="76" text-anchor="middle" font-size="14" style="font-family: ui-serif, Georgia, serif;" fill="currentColor">EST.</text>
          <text x="80" y="94" text-anchor="middle" font-size="10" letter-spacing="3" style="font-family: ui-monospace, monospace;" fill="currentColor">SAFARI</text>
        </svg>
      </div>

      <div class="relative mx-auto flex min-h-[60vh] max-w-7xl flex-col justify-end px-6 pb-8 pt-4 lg:min-h-[42vh] lg:px-12">

        <div class="grid gap-14 pb-16 pt-6 lg:grid-cols-[1.3fr_0.9fr] lg:items-end lg:gap-10 lg:pb-24 lg:pt-8">

        <!-- HERO CONTENT -->
        <div class="max-w-2xl">

          <div class="animate-fade-up mb-8 flex items-center gap-3 font-mono text-[10px] font-semibold uppercase tracking-[0.35em] text-[#C17F2E] opacity-0 sm:text-xs" style="animation-delay:120ms">

            <span class="h-px w-8 bg-[#C17F2E]"></span>

            {heroEyebrow}

          </div>

          <h1 class="animate-fade-up font-serif text-[9vw] font-semibold leading-[0.95] tracking-[-0.03em] opacity-0 sm:text-5xl lg:text-6xl" style="animation-delay:220ms">
            {heroHeadingLine1}
            <br />
            {heroHeadingLine2}
          </h1>

          <p class="animate-fade-up mt-8 max-w-2xl text-base leading-7 text-[color-mix(in_srgb,var(--color-text)_65%,transparent)] opacity-0 sm:text-lg sm:leading-8" style="animation-delay:340ms">
            {heroDescription}
          </p>

          <div class="animate-fade-up mt-10 flex flex-wrap items-center gap-4 opacity-0" style="animation-delay:460ms">

            <a
              href="/quote"
              class="group inline-flex items-center gap-4 rounded-full bg-[#C17F2E] px-7 py-4 text-sm font-semibold text-[#211C16] transition duration-300 hover:-translate-y-0.5 hover:bg-[#DDA556] hover:shadow-xl hover:shadow-[#C17F2E]/10"
            >
              {heroCtaPrimaryLabel}

              <span
                aria-hidden="true"
                class="transition-transform duration-300 group-hover:translate-x-1"
              >
                →
              </span>
            </a>

            <a
              href="/product"
              class="inline-flex items-center gap-2 rounded-full border border-dashed border-[color-mix(in_srgb,var(--color-text)_25%,transparent)] px-7 py-4 text-sm font-semibold text-[var(--color-text)] backdrop-blur transition duration-300 hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--color-text)_50%,transparent)] hover:bg-[color-mix(in_srgb,var(--color-text)_5%,transparent)]"
            >
              {heroCtaSecondaryLabel}
            </a>

            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-4 font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#C17F2E] transition hover:text-[#DDA556]"
            >
              {heroCtaWhatsappLabel} →
            </a>

          </div>

        </div>


        <!-- HERO PRODUCT CARD — single product, no carousel/menu -->
        <div class="animate-fade-up relative mx-auto w-full max-w-sm opacity-0 lg:mx-0" style="animation-delay:400ms">

          <div class="relative aspect-[4/5] w-full overflow-hidden rounded-[1.75rem] border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] bg-[#14110D]">

            <img
              src={product.data.image ?? '/goat2.png'}
              alt={product.data.name}
              loading="eager"
              class="h-full w-full object-cover"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-[#14110D]/90 via-[#14110D]/15 to-transparent"></div>

            <span class="absolute left-5 top-5 rounded-full border border-white/15 bg-black/40 px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.2em] text-[#F2EAD9] backdrop-blur">
              Whole Carcass Only
            </span>

            <div class="absolute inset-x-5 bottom-5">

              <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.25em] text-[#DDA556]">
                {product.data.weightMinKg}–{product.data.weightMaxKg} kg
              </p>

              <h3 class="mt-1.5 font-serif text-2xl font-semibold text-[#F2EAD9]">
                {product.data.name}
              </h3>

              <p class="mt-1 font-mono text-xs text-[#F2EAD9]/70">
                {product.data.packagingOptions.join(' or ')}
              </p>

            </div>

          </div>

          <p class="mt-4 flex items-center gap-2 font-mono text-[10px] font-semibold uppercase tracking-[0.3em] text-[color-mix(in_srgb,var(--color-text)_40%,transparent)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#C17F2E]"></span>
            The only product we supply
          </p>

        </div>

        </div>


        <!-- HERO LEDGER -->
        <div class="animate-fade-up grid grid-cols-2 gap-6 border-t border-dashed border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] py-6 font-mono opacity-0 sm:grid-cols-4" style="animation-delay:580ms">

          {heroLedger.map((item) => (
            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-[color-mix(in_srgb,var(--color-text)_40%,transparent)]">
                {item.number} &#8226; {item.category}
              </p>

              <p class="mt-1.5 text-sm font-medium text-[color-mix(in_srgb,var(--color-text)_90%,transparent)]">
                {item.value}
              </p>
            </div>
          ))}

        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- MANIFEST STRIP -->
    <!-- ========================================================= -->

    <section class="border-y border-dashed border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] bg-[var(--color-bg)] py-5">

      <div class="space-y-3">

        <!-- ROW ONE — MOVES LEFT -->
        <div class="ticker-mask relative overflow-hidden">

          <div class="ticker-left flex w-max items-center whitespace-nowrap">

            {Array(4).fill(0).map(() => (
              <div class="flex items-center">

                {tickerRow1.map((item) => (
                  <>
                    <span class="mx-6 font-mono text-[10px] font-medium uppercase tracking-[0.3em] text-[color-mix(in_srgb,var(--color-text)_45%,transparent)] sm:text-xs">
                      {item}
                    </span>

                    <span class="h-1 w-1 rounded-full bg-[#C17F2E]/70"></span>
                  </>
                ))}

              </div>
            ))}

          </div>

        </div>


        <!-- ROW TWO — MOVES RIGHT -->
        <div class="ticker-mask relative overflow-hidden">

          <div class="ticker-right flex w-max items-center whitespace-nowrap">

            {Array(4).fill(0).map(() => (
              <div class="flex items-center">

                {tickerRow2.map((item) => (
                  <>
                    <span class="mx-6 font-mono text-[10px] font-medium uppercase tracking-[0.3em] text-[color-mix(in_srgb,var(--color-text)_25%,transparent)] sm:text-xs">
                      {item}
                    </span>

                    <span class="h-1 w-1 rounded-full bg-[#4B5D42]/50"></span>
                  </>
                ))}

              </div>
            ))}

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- PRODUCTS -->
    <!-- ========================================================= -->

    <section class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">

      <div class="reveal flex flex-col justify-between gap-8 md:flex-row md:items-end">

        <div class="max-w-2xl">

          <div class="flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-[#C17F2E]">

            <span class="h-2 w-2 rotate-45 bg-[#C17F2E]"></span>

            {productsEyebrow}

          </div>

          <h2 class="mt-5 font-serif text-4xl font-semibold leading-[1] tracking-[-0.02em] text-[var(--color-text)] sm:text-5xl lg:text-6xl">
            {productsHeadingLine1}
            <br />
            {productsHeadingLine2}
          </h2>

          <p class="mt-6 max-w-xl text-base leading-7 text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            {productsDescription}
          </p>

        </div>


        <a
          href="/product"
          class="group inline-flex w-fit items-center gap-3 rounded-full border border-[color-mix(in_srgb,var(--color-text)_20%,transparent)] bg-[var(--color-bg)] px-5 py-3 font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-text)] transition hover:border-[var(--color-text)] hover:bg-[var(--color-text)] hover:text-[var(--color-bg)]"
        >
          {productsCtaLabel}

          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </a>

      </div>


      <!-- SINGLE PRODUCT SPEC PANEL — no catalog, no menu, one product only -->

      <div class="reveal mt-16 overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_12%,transparent)] bg-[var(--color-bg-soft)] lg:grid lg:grid-cols-[0.9fr_1.1fr]">

        <div class="relative aspect-[4/3] overflow-hidden bg-[var(--color-bg-soft-2)] lg:aspect-auto">
          <img
            src={product.data.image ?? '/goat2.png'}
            alt={product.data.name}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>

        <div class="p-6 sm:p-10">

          <h3 class="font-serif text-2xl font-semibold tracking-tight text-[var(--color-text)] sm:text-3xl">
            {product.data.name}
          </h3>

          {product.data.description && (
            <p class="mt-3 text-sm sm:text-base leading-relaxed text-[color-mix(in_srgb,var(--color-text)_65%,transparent)]">
              {product.data.description}
            </p>
          )}

          <dl class="mt-8 grid gap-6 border-t border-dashed border-[color-mix(in_srgb,var(--color-text)_12%,transparent)] pt-6 sm:grid-cols-2">
            <div>
              <dt class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
                Typical weight
              </dt>
              <dd class="mt-1.5 text-base font-medium text-[var(--color-text)]">
                {product.data.weightMinKg}–{product.data.weightMaxKg} kg
              </dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
                Form
              </dt>
              <dd class="mt-1.5 text-base font-medium text-[var(--color-text)]">
                {product.data.form}
              </dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
                Processing
              </dt>
              <dd class="mt-1.5 text-base font-medium text-[var(--color-text)]">
                {product.data.processing}
              </dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
                Packaging
              </dt>
              <dd class="mt-1.5 text-base font-medium text-[var(--color-text)]">
                {product.data.packagingOptions.join(' or ')}
              </dd>
            </div>
          </dl>

          <a
            href="/quote"
            class="group mt-8 inline-flex items-center gap-3 rounded-full bg-[#C17F2E] px-6 py-3 text-sm font-semibold text-[#211C16] transition hover:bg-[#DDA556]"
          >
            Request a Quote
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- WHY SAFARI MEAT -->
    <!-- ========================================================= -->

    <section class="border-y border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[var(--color-bg-soft)]">

      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-28">

        <div class="reveal grid gap-16 lg:grid-cols-[0.8fr_1.2fr]">

          <div>

            <div class="flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-[#C17F2E]">

              <span class="h-2 w-2 rotate-45 bg-[#C17F2E]"></span>

              {whySupplyEyebrow}

            </div>

            <h2 class="mt-5 max-w-md font-serif text-4xl font-semibold leading-tight tracking-[-0.02em] text-[var(--color-text)] sm:text-5xl">
              {whySupplyHeadingLine1}
              <br />
              {whySupplyHeadingLine2}
            </h2>

          </div>


          <div class="grid gap-px overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_12%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_10%,transparent)] sm:grid-cols-2">

            {whySupplyCards.map((card) => (
              <div class="bg-[var(--color-bg)] p-8">

                <span class="font-mono text-xs font-semibold tracking-[0.15em] text-[#C17F2E]">
                  {card.code}
                </span>

                <h3 class="mt-12 font-serif text-xl font-semibold">
                  {card.title}
                </h3>

                <p class="mt-3 text-sm leading-6 text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                  {card.description}
                </p>

              </div>
            ))}

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- FINAL CTA -->
    <!-- ========================================================= -->

    <section class="relative overflow-hidden bg-[var(--color-bg)] text-[var(--color-text)]">

      <div class="pointer-events-none absolute -bottom-16 -right-16 hidden h-56 w-56 rotate-12 text-[#4B5D42]/40 sm:block">
        <svg viewBox="0 0 160 160" class="h-full w-full">
          <defs>
            <path id="stampRing2" d="M 80,80 m -62,0 a 62,62 0 1,1 124,0 a 62,62 0 1,1 -124,0" />
          </defs>
          <circle cx="80" cy="80" r="74" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 5" />
          <circle cx="80" cy="80" r="50" fill="none" stroke="currentColor" stroke-width="1" />
          <text font-size="8.5" letter-spacing="2.5" fill="currentColor" style="font-family: ui-monospace, monospace;">
            <textPath href="#stampRing2" startOffset="2%">HALAL CERTIFIED &#8226; COLD CHAIN &#8226; HALAL CERTIFIED &#8226;</textPath>
          </text>
        </svg>
      </div>

      <div class="relative mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">

        <div class="reveal grid items-end gap-12 lg:grid-cols-[1.2fr_0.8fr]">

          <div>

            <div class="flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-[#C17F2E]">

              <span class="h-px w-7 bg-[#C17F2E]"></span>

              {ctaEyebrow}

            </div>

            <h2 class="mt-6 max-w-4xl font-serif text-4xl font-semibold leading-[0.98] tracking-[-0.02em] sm:text-5xl lg:text-7xl">
              {ctaHeading}
            </h2>

          </div>


          <div>

            <p class="max-w-md text-base leading-7 text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              {ctaDescription}
            </p>


            <div class="mt-8 flex flex-wrap gap-3">

              <a
                href="/quote"
