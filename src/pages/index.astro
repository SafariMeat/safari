---
import Layout from '../components/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
const products = await getCollection('products');
const contact = await getEntry('contact', 'contact');

const whatsappUrl = `https://wa.me/${contact.data.whatsapp}`;
---

<Layout title={home.data.heading}>
  <main class="bg-[#F2EAD9] text-[#211C16]">

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="relative min-h-screen overflow-hidden bg-[#211C16] text-[#F2EAD9]">

      <img
        src="/images/hero-goat-meat.jpg"
        alt="Premium export-ready goat meat"
        class="absolute inset-0 h-full w-full object-cover opacity-25"
      />

      <div class="absolute inset-0 bg-gradient-to-r from-[#211C16] via-[#211C16]/80 to-[#211C16]/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#211C16] via-transparent to-transparent"></div>

      <!-- signature certification stamp -->
      <div class="pointer-events-none absolute right-6 top-28 hidden h-40 w-40 -rotate-6 text-[#C17F2E]/70 sm:block lg:right-16 lg:h-52 lg:w-52">
        <svg viewBox="0 0 160 160" class="h-full w-full">
          <defs>
            <path id="stampRing" d="M 80,80 m -62,0 a 62,62 0 1,1 124,0 a 62,62 0 1,1 -124,0" />
          </defs>
          <circle cx="80" cy="80" r="74" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 5" />
          <circle cx="80" cy="80" r="50" fill="none" stroke="currentColor" stroke-width="1" />
          <text font-size="8.5" letter-spacing="2.5" fill="currentColor" style="font-family: ui-monospace, monospace;">
            <textPath href="#stampRing" startOffset="2%">CERTIFIED &#8226; EXPORT GRADE &#8226; CERTIFIED &#8226; EXPORT GRADE &#8226;</textPath>
          </text>
          <text x="80" y="76" text-anchor="middle" font-size="14" style="font-family: ui-serif, Georgia, serif;" fill="currentColor">EST.</text>
          <text x="80" y="94" text-anchor="middle" font-size="10" letter-spacing="3" style="font-family: ui-monospace, monospace;" fill="currentColor">SAFARI</text>
        </svg>
      </div>

      <div class="relative mx-auto flex min-h-screen max-w-7xl flex-col justify-between px-6 py-8 lg:px-12">

        <!-- HEADER -->
        <header class="flex items-center justify-between">

          <a
            href="/"
            class="group flex items-center gap-3"
            aria-label="Safari Meat homepage"
          >
            <span class="flex h-10 w-10 items-center justify-center rounded-full border border-[#F2EAD9]/15 bg-[#F2EAD9]/5 backdrop-blur">
              <span class="h-2 w-2 rotate-45 bg-[#C17F2E]"></span>
            </span>

            <span class="font-mono text-sm font-semibold uppercase tracking-[0.2em]">
              Safari Meat
            </span>
          </a>

          <nav class="hidden items-center gap-8 font-mono text-xs uppercase tracking-[0.15em] text-[#F2EAD9]/70 md:flex">

            <a
              href="/products"
              class="transition hover:text-[#F2EAD9]"
            >
              Products
            </a>

            <a
              href="/quote"
              class="transition hover:text-[#F2EAD9]"
            >
              Wholesale
            </a>

            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full border border-[#F2EAD9]/15 bg-[#F2EAD9]/5 px-5 py-2.5 font-semibold tracking-[0.1em] backdrop-blur transition hover:border-[#F2EAD9]/30 hover:bg-[#F2EAD9]/10"
            >
              Contact
            </a>

          </nav>

        </header>


        <!-- HERO CONTENT -->
        <div class="max-w-5xl pb-16 pt-24 lg:pb-24">

          <div class="mb-8 flex items-center gap-3 font-mono text-[10px] font-semibold uppercase tracking-[0.35em] text-[#C17F2E] sm:text-xs">

            <span class="h-px w-8 bg-[#C17F2E]"></span>

            Manifest No. SM-2026 &#8212; East African Exporters

          </div>

          <h1 class="max-w-5xl font-serif text-[13vw] font-semibold leading-[0.92] tracking-[-0.03em] sm:text-7xl lg:text-[6.25rem]">
            {home.data.heading}
          </h1>

          <p class="mt-8 max-w-2xl text-base leading-7 text-[#F2EAD9]/65 sm:text-lg sm:leading-8">
            Premium, export-ready goat meat supplied to international wholesale
            buyers — professionally sourced, quality controlled, packaged and
            handled through a reliable cold chain from East Africa to your market.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-4">

            <a
              href="/quote"
              class="group inline-flex items-center gap-4 rounded-full bg-[#C17F2E] px-7 py-4 text-sm font-semibold text-[#211C16] transition duration-300 hover:bg-[#DDA556] hover:shadow-xl hover:shadow-[#C17F2E]/10"
            >
              Request a Quotation

              <span
                aria-hidden="true"
                class="transition-transform duration-300 group-hover:translate-x-1"
              >
                →
              </span>
            </a>

            <a
              href="/products"
              class="inline-flex items-center gap-2 rounded-full border border-dashed border-[#F2EAD9]/25 px-7 py-4 text-sm font-semibold text-[#F2EAD9] backdrop-blur transition duration-300 hover:border-[#F2EAD9]/50 hover:bg-[#F2EAD9]/5"
            >
              Explore Products
            </a>

            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-4 font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#C17F2E] transition hover:text-[#DDA556]"
            >
              WhatsApp Sales →
            </a>

          </div>

        </div>


        <!-- HERO LEDGER -->
        <div class="grid grid-cols-2 gap-6 border-t border-dashed border-[#F2EAD9]/15 py-6 font-mono sm:grid-cols-4">

          <div>
            <p class="text-[10px] uppercase tracking-[0.25em] text-[#F2EAD9]/40">
              01 &#8226; Quality
            </p>

            <p class="mt-1.5 text-sm font-medium text-[#F2EAD9]/90">
              Controlled sourcing
            </p>
          </div>

          <div>
            <p class="text-[10px] uppercase tracking-[0.25em] text-[#F2EAD9]/40">
              02 &#8226; Handling
            </p>

            <p class="mt-1.5 text-sm font-medium text-[#F2EAD9]/90">
              Cold-chain
            </p>
          </div>

          <div>
            <p class="text-[10px] uppercase tracking-[0.25em] text-[#F2EAD9]/40">
              03 &#8226; Supply
            </p>

            <p class="mt-1.5 text-sm font-medium text-[#F2EAD9]/90">
              Wholesale volumes
            </p>
          </div>

          <div>
            <p class="text-[10px] uppercase tracking-[0.25em] text-[#F2EAD9]/40">
              04 &#8226; Origin
            </p>

            <p class="mt-1.5 text-sm font-medium text-[#F2EAD9]/90">
              East Africa
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- MANIFEST STRIP TICKER -->
    <!-- ========================================================= -->

    <section class="overflow-hidden border-y border-dashed border-[#211C16]/15 bg-[#F2EAD9] py-4">

      <div class="space-y-2">

        <!-- ROW ONE — MOVES LEFT -->
        <div class="relative overflow-hidden">

          <div class="ticker-left flex w-max items-center whitespace-nowrap">

            {Array(4).fill(0).map(() => (
              <div class="flex items-center">

                <span class="mx-5 font-mono text-[10px] font-semibold uppercase tracking-[0.28em] text-[#211C16]/55 sm:text-xs">
                  Premium Goat Meat
                </span>

                <span class="text-[#C17F2E]">&#8212;</span>

                <span class="mx-5 font-mono text-[10px] font-semibold uppercase tracking-[0.28em] text-[#211C16]/55 sm:text-xs">
                  Export Ready
                </span>

                <span class="text-[#C17F2E]">&#8212;</span>

                <span class="mx-5 font-mono text-[10px] font-semibold uppercase tracking-[0.28em] text-[#211C16]/55 sm:text-xs">
                  East African Origin
                </span>

                <span class="text-[#C17F2E]">&#8212;</span>

                <span class="mx-5 font-mono text-[10px] font-semibold uppercase tracking-[0.28em] text-[#211C16]/55 sm:text-xs">
                  Wholesale Supply
                </span>

                <span class="text-[#C17F2E]">&#8212;</span>

              </div>
            ))}

          </div>

        </div>


        <!-- ROW TWO — MOVES RIGHT -->
        <div class="relative overflow-hidden">

          <div class="ticker-right flex w-max items-center whitespace-nowrap">

            {Array(4).fill(0).map(() => (
              <div class="flex items-center">

                <span class="mx-5 font-mono text-[10px] font-semibold uppercase tracking-[0.28em] text-[#211C16]/35 sm:text-xs">
                  Halal Certified
                </span>

                <span class="text-[#4B5D42]/60">&#8212;</span>

                <span class="mx-5 font-mono text-[10px] font-semibold uppercase tracking-[0.28em] text-[#211C16]/35 sm:text-xs">
                  Cold-Chain Handling
                </span>

                <span class="text-[#4B5D42]/60">&#8212;</span>

                <span class="mx-5 font-mono text-[10px] font-semibold uppercase tracking-[0.28em] text-[#211C16]/35 sm:text-xs">
                  Professional Packaging
                </span>

                <span class="text-[#4B5D42]/60">&#8212;</span>

                <span class="mx-5 font-mono text-[10px] font-semibold uppercase tracking-[0.28em] text-[#211C16]/35 sm:text-xs">
                  Export Documentation
                </span>

                <span class="text-[#4B5D42]/60">&#8212;</span>

              </div>
            ))}

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- PRODUCTS -->
    <!-- ========================================================= -->

    <section class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">

      <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">

        <div class="max-w-2xl">

          <div class="flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-[#C17F2E]">

            <span class="h-2 w-2 rotate-45 bg-[#C17F2E]"></span>

            Product Ledger

          </div>

          <h2 class="mt-5 font-serif text-4xl font-semibold leading-[1] tracking-[-0.02em] text-[#211C16] sm:text-5xl lg:text-6xl">
            Premium goat meat.
            <br />
            Ready for export.
          </h2>

          <p class="mt-6 max-w-xl text-base leading-7 text-[#211C16]/55">
            Carefully sourced products prepared for wholesale buyers,
            distributors, restaurants and international markets.
          </p>

        </div>


        <a
          href="/products"
          class="group inline-flex w-fit items-center gap-3 rounded-full border border-[#211C16]/20 bg-[#F2EAD9] px-5 py-3 font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#211C16] transition hover:border-[#211C16] hover:bg-[#211C16] hover:text-[#F2EAD9]"
        >
          View full manifest

          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </a>

      </div>


      <!-- PRODUCT GRID -->

      <ul class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">

        {products.map((p, i) => {

          const outOfStock = !p.data.inStock;
          const lot = `LOT-${String(i + 1).padStart(2, '0')}`;

          return (
            <li class="group">

              <a
                href={`/products/${p.slug}`}
                class="block overflow-hidden rounded-2xl border border-[#211C16]/12 bg-[#FAF4E7] transition duration-500 hover:-translate-y-1 hover:border-[#211C16]/25 hover:shadow-2xl hover:shadow-[#211C16]/10"
              >

                <div class="relative aspect-[4/3] overflow-hidden bg-[#EADFC7]">

                  <img
                    src={p.data.image ?? '/images/product-placeholder.jpg'}
                    alt={p.data.name}
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
                  />

                  <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent opacity-0 transition duration-500 group-hover:opacity-100"></div>

                  <span class="absolute left-4 top-4 rounded-full border border-[#211C16]/15 bg-[#211C16]/70 px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.15em] text-[#F2EAD9] backdrop-blur">
                    {lot}
                  </span>

                  {outOfStock && (
                    <span class="absolute right-4 top-4 -rotate-6 rounded-md border border-dashed border-[#9C3B2C] bg-[#F2EAD9]/90 px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.15em] text-[#9C3B2C]">
                      Out of Stock
                    </span>
                  )}

                </div>


                <div class="p-6 sm:p-7">

                  <div class="flex items-start justify-between gap-5">

                    <div>

                      <h3 class="font-serif text-xl font-semibold tracking-tight text-[#211C16]">
                        {p.data.name}
                      </h3>

                      <p class="mt-2 font-mono text-sm text-[#211C16]/50">
                        Ksh {p.data.pricePerKg} / {p.data.unit}
                      </p>

                    </div>

                    <span
                      aria-hidden="true"
                      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#211C16]/15 text-[#211C16]/50 transition duration-300 group-hover:border-[#C17F2E] group-hover:bg-[#C17F2E] group-hover:text-[#211C16]"
                    >
                      ↗
                    </span>

                  </div>

                  <div class="mt-7 border-t border-dashed border-[#211C16]/12 pt-5">

                    <span class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#211C16]/50 transition group-hover:text-[#C17F2E]">
                      View product details
                    </span>

                  </div>

                </div>

              </a>

            </li>
          );

        })}

      </ul>

    </section>


    <!-- ========================================================= -->
    <!-- WHY SAFARI MEAT -->
    <!-- ========================================================= -->

    <section class="border-y border-[#211C16]/10 bg-[#FAF4E7]">

      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-28">

        <div class="grid gap-16 lg:grid-cols-[0.8fr_1.2fr]">

          <div>

            <div class="flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-[#C17F2E]">

              <span class="h-2 w-2 rotate-45 bg-[#C17F2E]"></span>

              Terms of Supply

            </div>

            <h2 class="mt-5 max-w-md font-serif text-4xl font-semibold leading-tight tracking-[-0.02em] text-[#211C16] sm:text-5xl">
              A supply partner,
              <br />
              not just a supplier.
            </h2>

          </div>


          <div class="grid gap-px overflow-hidden rounded-2xl border border-[#211C16]/12 bg-[#211C16]/10 sm:grid-cols-2">

            <div class="bg-[#F2EAD9] p-8">

              <span class="font-mono text-xs font-semibold tracking-[0.15em] text-[#C17F2E]">
                &#167; SRC
              </span>

              <h3 class="mt-12 font-serif text-xl font-semibold">
                Reliable sourcing
              </h3>

              <p class="mt-3 text-sm leading-6 text-[#211C16]/55">
                Consistent sourcing standards designed to support
                repeat wholesale orders.
              </p>

            </div>


            <div class="bg-[#F2EAD9] p-8">

              <span class="font-mono text-xs font-semibold tracking-[0.15em] text-[#C17F2E]">
                &#167; HDL
              </span>

              <h3 class="mt-12 font-serif text-xl font-semibold">
                Professional handling
              </h3>

              <p class="mt-3 text-sm leading-6 text-[#211C16]/55">
                Proper packaging and cold-chain handling from
                preparation through delivery.
              </p>

            </div>


            <div class="bg-[#F2EAD9] p-8">

              <span class="font-mono text-xs font-semibold tracking-[0.15em] text-[#C17F2E]">
                &#167; EXP
              </span>

              <h3 class="mt-12 font-serif text-xl font-semibold">
                Export focused
              </h3>

              <p class="mt-3 text-sm leading-6 text-[#211C16]/55">
                Documentation and processes designed around
                international wholesale requirements.
              </p>

            </div>


            <div class="bg-[#F2EAD9] p-8">

              <span class="font-mono text-xs font-semibold tracking-[0.15em] text-[#C17F2E]">
                &#167; SLS
              </span>

              <h3 class="mt-12 font-serif text-xl font-semibold">
                Responsive sales
              </h3>

              <p class="mt-3 text-sm leading-6 text-[#211C16]/55">
                Clear communication on specifications, quantities,
                pricing and shipping requirements.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- FINAL CTA -->
    <!-- ========================================================= -->

    <section class="relative overflow-hidden bg-[#211C16] text-[#F2EAD9]">

      <div class="pointer-events-none absolute -bottom-16 -right-16 hidden h-56 w-56 rotate-12 text-[#4B5D42]/40 sm:block">
        <svg viewBox="0 0 160 160" class="h-full w-full">
          <defs>
            <path id="stampRing2" d="M 80,80 m -62,0 a 62,62 0 1,1 124,0 a 62,62 0 1,1 -124,0" />
          </defs>
          <circle cx="80" cy="80" r="74" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 5" />
          <circle cx="80" cy="80" r="50" fill="none" stroke="currentColor" stroke-width="1" />
          <text font-size="8.5" letter-spacing="2.5" fill="currentColor" style="font-family: ui-monospace, monospace;">
            <textPath href="#stampRing2" startOffset="2%">HALAL CERTIFIED &#8226; COLD CHAIN &#8226; HALAL CERTIFIED &#8226;</textPath>
          </text>
        </svg>
      </div>

      <div class="relative mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">

        <div class="grid items-end gap-12 lg:grid-cols-[1.2fr_0.8fr]">

          <div>

            <div class="flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-[#C17F2E]">

              <span class="h-px w-7 bg-[#C17F2E]"></span>

              Start a conversation

            </div>

            <h2 class="mt-6 max-w-4xl font-serif text-4xl font-semibold leading-[0.98] tracking-[-0.02em] sm:text-5xl lg:text-7xl">
              Looking for a reliable East African goat meat supplier?
            </h2>

          </div>


          <div>

            <p class="max-w-md text-base leading-7 text-[#F2EAD9]/55">
              Request product specifications, pricing, quantities and
              shipping information. Our team responds promptly to
              wholesale enquiries.
            </p>


            <div class="mt-8 flex flex-wrap gap-3">

              <a
                href="/quote"
                class="group inline-flex items-center gap-4 rounded-full bg-[#C17F2E] px-7 py-4 text-sm font-semibold text-[#211C16] transition hover:bg-[#DDA556]"
              >
                Request a Quote

                <span
                  aria-hidden="true"
                  class="transition-transform duration-300 group-hover:translate-x-1"
                >
                  →
                </span>
              </a>


              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-full border border-dashed border-[#F2EAD9]/25 px-7 py-4 text-sm font-semibold text-[#F2EAD9] backdrop-blur transition hover:border-[#F2EAD9]/50 hover:bg-[#F2EAD9]/5"
              >
                Contact Sales
              </a>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- FOOTER -->
    <!-- ========================================================= -->

    <footer class="bg-[#211C16] text-[#F2EAD9]/45">

      <div class="mx-auto flex max-w-7xl flex-col gap-5 border-t border-dashed border-[#F2EAD9]/10 px-6 py-8 font-mono text-xs uppercase tracking-[0.1em] sm:flex-row sm:items-center sm:justify-between lg:px-12">

        <p>
          © {new Date().getFullYear()} Safari Meat.
          All rights reserved.
        </p>

        <div class="flex items-center gap-6">

          <a
            href="/products"
            class="transition hover:text-[#F2EAD9]"
          >
            Products
          </a>

          <a
            href="/quote"
            class="transition hover:text-[#F2EAD9]"
          >
            Wholesale
          </a>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="transition hover:text-[#F2EAD9]"
          >
            WhatsApp
          </a>

        </div>

      </div>

    </footer>

  </main>
</Layout>


<style>
  /*
   * Manifest strip ticker
   */

  .ticker-left {
    animation: ticker-left 32s linear infinite;
  }

  .ticker-right {
    animation: ticker-right 36s linear infinite;
  }

  @keyframes ticker-left {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-25%);
    }
  }

  @keyframes ticker-right {
    from {
      transform: translateX(-25%);
    }

    to {
      transform: translateX(0);
    }
  }

  /*
   * Pause both rows when the user hovers over them.
   */

  .ticker-left:hover,
  .ticker-right:hover {
    animation-play-state: paused;
  }

  /*
   * Respect reduced-motion preferences.
   */

  @media (prefers-reduced-motion: reduce) {
    .ticker-left,
    .ticker-right {
      animation: none;
    }
  }
</style>
