<script>
  // astro:page-load fires on every navigation (first load and every
  // client-side route swap), so scroll-reveal keeps working when this page
  // is revisited later in the same session.
  document.addEventListener('astro:page-load', () => {
    const revealEls = document.querySelectorAll('.reveal');

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    );

    revealEls.forEach((el) => observer.observe(el));
  });

  // Hero ambient background — a couple of pixels of pointer-driven
  // parallax layered on top of the idle drift animations defined in CSS.
  // Skipped entirely for reduced motion. Cleans up its own listener on
  // every astro:page-load so repeat visits never stack handlers.
  document.addEventListener('astro:page-load', () => {
    const ambient = document.querySelector('[data-hero-ambient]');
    if (!ambient) return;

    if (window.__heroAmbientMove) {
      document.removeEventListener('mousemove', window.__heroAmbientMove);
      window.__heroAmbientMove = null;
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const hero = ambient.closest('section');
    if (!hero) return;

    const MAX_SHIFT = 8;
    let ticking = false;
    let lastEvent = null;

    const apply = () => {
      ticking = false;
      if (!lastEvent) return;
      const rect = hero.getBoundingClientRect();
      const px = (lastEvent.clientX - rect.left) / rect.width - 0.5;
      const py = (lastEvent.clientY - rect.top) / rect.height - 0.5;
      ambient.style.setProperty('--amb-x', (px * MAX_SHIFT * -1).toFixed(2));
      ambient.style.setProperty('--amb-y', (py * MAX_SHIFT * -1).toFixed(2));
    };

    const handleMove = (e) => {
      const rect = hero.getBoundingClientRect();
      if (e.clientY < rect.top || e.clientY > rect.bottom) return;
      lastEvent = e;
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(apply);
      }
    };

    window.__heroAmbientMove = handleMove;
    document.addEventListener('mousemove', handleMove);
  });

  // Hero product slider — a layered three-card carousel. Every slide's
  // position (active / next / prev / hidden) is recalculated as an offset
  // from the current index each time it changes, so the outgoing active
  // card glides smoothly back into the subdued background stack while the
  // incoming card rises into focus — all driven by CSS transitions on a
  // single `data-position` attribute, no DOM reordering required.
  // Re-initialised on every astro:page-load (first load + every
  // client-side route swap), with the previous interval cleared first so
  // repeat visits never stack timers.
  document.addEventListener('astro:page-load', () => {
    const slider = document.querySelector('[data-hero-slider]');
    if (!slider) return;

    const slides = Array.from(slider.querySelectorAll('.hero-slide'));
    const dots = Array.from(slider.parentElement?.querySelectorAll('.hero-dot') ?? []);
    const navPrev = slider.querySelector('[data-nav="prev"]');
    const navNext = slider.querySelector('[data-nav="next"]');

    if (window.__heroSliderTimer) {
      clearInterval(window.__heroSliderTimer);
      window.__heroSliderTimer = null;
    }

    if (slides.length < 1) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SLIDE_MS = 4500;
    const length = slides.length;

    let index = Math.max(
      0,
      slides.findIndex((s) => s.dataset.position === 'active')
    );

    // Classify a slide's role purely from its circular distance ahead of
    // the active index — this is what makes the transition feel physical:
    // the card that was active naturally lands on "prev" (one step behind
    // the new active card) rather than being explicitly animated there.
    const classify = (offset) => {
      if (offset === 0) return 'active';
      if (offset === 1) return 'next';
      if (offset === length - 1) return 'prev';
      return 'hidden';
    };

    const render = () => {
      slides.forEach((slide, i) => {
        const offset = (i - index + length) % length;
        slide.dataset.position = classify(offset);
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
      });
    };

    const goTo = (next) => {
      if (next === index) return;
      index = ((next % length) + length) % length;
      render();
    };

    const start = () => {
      if (prefersReducedMotion || length < 2) return;
      window.__heroSliderTimer = window.setInterval(() => {
        goTo(index + 1);
      }, SLIDE_MS);
    };

    const stop = () => {
      if (window.__heroSliderTimer) {
        clearInterval(window.__heroSliderTimer);
        window.__heroSliderTimer = null;
      }
    };

    const restart = (next) => {
      stop();
      goTo(next);
      start();
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => restart(i));
    });

    slides.forEach((slide, i) => {
      slide.addEventListener('click', () => {
        // Only the subdued side cards act as navigation shortcuts — the
        // active card itself isn't a button to "go" anywhere.
        if (slide.dataset.position === 'active') return;
        restart(i);
      });
    });

    navPrev?.addEventListener('click', () => restart(index - 1));
    navNext?.addEventListener('click', () => restart(index + 1));

    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);
    slider.addEventListener('focusin', stop);
    slider.addEventListener('focusout', start);

    // Subtle pointer-driven 3D tilt on the active card — a light,
    // glassy parallax that reinforces the depth of the layered stack
    // without fighting the position transitions (skipped for reduced
    // motion).
    if (!prefersReducedMotion) {
      const MAX_TILT = 4;

      const handleMove = (e) => {
        const active = slides[index];
        if (!active) return;
        const rect = active.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;
        const py = (e.clientY - rect.top) / rect.height;
        const tiltY = (px - 0.5) * 2 * MAX_TILT;
        const tiltX = (0.5 - py) * 2 * MAX_TILT;
        active.classList.add('is-tilting');
        active.style.setProperty('--tilt-x', `${tiltX.toFixed(2)}deg`);
        active.style.setProperty('--tilt-y', `${tiltY.toFixed(2)}deg`);
      };

      const resetTilt = () => {
        const active = slides[index];
        if (!active) return;
        active.classList.remove('is-tilting');
        active.style.setProperty('--tilt-x', '0deg');
        active.style.setProperty('--tilt-y', '0deg');
      };

      slider.addEventListener('mousemove', handleMove);
      slider.addEventListener('mouseleave', resetTilt);
    }

    render();
    start();
  });
</script>

<style>
  /*
   * Hero ambient background — a sleek, modern impression of global export
   * logistics: drifting mesh-gradient light, a fine parallax dot-grid,
   * and animated trade-route lines with travelling pulses. Everything
   * moves slowly and stays low-contrast so the hero copy sitting on top
   * of it is never fought for attention. The scrim keeps this dark and
   * premium regardless of the site's light/dark toggle, matching a
   * confident export brand rather than the page theme.
   */

  .hero-ambient {
    z-index: 0;
  }

  .hero-ambient-scrim {
    background:
      radial-gradient(120% 90% at 78% 15%, rgba(193, 127, 46, 0.14), transparent 55%),
      linear-gradient(180deg, rgba(10, 9, 8, 0.78) 0%, rgba(14, 12, 10, 0.86) 55%, rgba(10, 9, 8, 0.94) 100%);
  }

  .hero-ambient-vignette {
    background: radial-gradient(120% 100% at 50% 30%, transparent 45%, rgba(6, 5, 4, 0.55) 100%);
  }

  .hero-ambient-svg {
    opacity: 0.9;
  }

  /* Mesh-gradient glows — large, very soft blurred blobs that drift
     slowly, giving the hero a bit of colour and depth without ever
     reading as a literal shape. */
  .hero-amb-mesh {
    filter: blur(60px);
    mix-blend-mode: screen;
  }

  .hero-amb-glow {
    position: absolute;
    border-radius: 9999px;
    opacity: 0.4;
    will-change: transform;
  }

  .hero-amb-glow--a {
    top: -10%;
    right: 4%;
    width: 42vw;
    height: 42vw;
    background: radial-gradient(circle, rgba(193, 127, 46, 0.55), transparent 70%);
    animation: hero-amb-drift-a 22s ease-in-out infinite;
  }

  .hero-amb-glow--b {
    bottom: -15%;
    left: -6%;
    width: 34vw;
    height: 34vw;
    background: radial-gradient(circle, rgba(221, 165, 86, 0.35), transparent 70%);
    animation: hero-amb-drift-b 26s ease-in-out infinite;
  }

  .hero-amb-glow--c {
    top: 30%;
    left: 40%;
    width: 26vw;
    height: 26vw;
    background: radial-gradient(circle, rgba(242, 234, 217, 0.18), transparent 70%);
    animation: hero-amb-drift-c 19s ease-in-out infinite;
  }

  .hero-amb-route {
    stroke-dasharray: 14 10;
    animation: hero-amb-route-flow 26s linear infinite;
  }

  .hero-amb-route--a { animation-duration: 24s; }
  .hero-amb-route--b { animation-duration: 30s; animation-direction: reverse; }
  .hero-amb-route--c { animation-duration: 36s; }

  .hero-amb-pulse {
    animation: hero-amb-pulse-fade 1.2s ease-in-out infinite alternate;
  }

  .hero-amb-particles {
    overflow: hidden;
  }

  .hero-amb-p {
    position: absolute;
    left: var(--x);
    bottom: -5%;
    width: var(--size);
    height: var(--size);
    border-radius: 9999px;
    background: rgba(232, 221, 201, 0.5);
    filter: blur(0.5px);
    animation: hero-amb-rise var(--dur) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes hero-amb-drift-a {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-4%, 6%, 0) scale(1.12); }
  }

  @keyframes hero-amb-drift-b {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(5%, -5%, 0) scale(1.08); }
  }

  @keyframes hero-amb-drift-c {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-3%, -4%, 0) scale(0.92); }
  }

  @keyframes hero-amb-route-flow {
    to { stroke-dashoffset: -480; }
  }

  @keyframes hero-amb-pulse-fade {
    0% { opacity: 0.55; }
    100% { opacity: 1; }
  }

  @keyframes hero-amb-rise {
    0% { transform: translate3d(0, 0, 0); opacity: 0; }
    12% { opacity: 0.6; }
    85% { opacity: 0.35; }
    100% { transform: translate3d(0, -420px, 0); opacity: 0; }
  }

  /* Gentle whole-layer parallax on pointer move — a couple of pixels at
     most, purely additive to the idle animations above. */
  .hero-ambient-svg,
  .hero-amb-particles,
  .hero-amb-mesh {
    transform: translate3d(calc(var(--amb-x, 0) * 1px), calc(var(--amb-y, 0) * 1px), 0);
    transition: transform 0.6s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-amb-glow,
    .hero-amb-route,
    .hero-amb-pulse,
    .hero-amb-p {
      animation: none !important;
    }

    .hero-amb-pulse {
      opacity: 0 !important;
    }

    .hero-ambient-svg,
    .hero-amb-particles,
    .hero-amb-mesh {
      transition: none;
      transform: none !important;
    }

    .hero-amb-p {
      opacity: 0.25;
      bottom: 30%;
    }
  }

  /*
   * Manifest strip — slow, ambient drift rather than a busy marquee.
   */

  .ticker-left {
    animation: ticker-left 140s linear infinite;
  }

  .ticker-right {
    animation: ticker-right 160s linear infinite;
  }

  @keyframes ticker-left {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-25%);
    }
  }

  @keyframes ticker-right {
    from {
      transform: translateX(-25%);
    }

    to {
      transform: translateX(0);
    }
  }

  /* Fade the strip out at both edges instead of a hard clip */
  .ticker-mask {
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  /*
   * Pause both rows when the user hovers over them.
   */

  .ticker-left:hover,
  .ticker-right:hover {
    animation-play-state: paused;
  }

  /*
   * Hero entrance — staggered fade + rise, driven by inline animation-delay.
   */

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /*
   * Scroll reveal for sections below the fold.
   */

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /*
   * Hero product slide — a layered, cinematic three-card carousel. The
   * active card sits front-and-centre, lifted slightly above the two
   * subdued background cards that peek out to either side. Every card
   * transitions between four possible roles (active / next / prev /
   * hidden) purely by re-setting a `data-position` attribute, so moving
   * to the next or previous product feels like the cards are physically
   * repositioning themselves in 3D space rather than swapping places.
   */

  .hero-slider {
    perspective: 1800px;
  }

  .hero-slider-stage {
    transform-style: preserve-3d;
    /* Modest breathing room above/below — just enough for the side cards
       to peek out without being clipped by the stage bounds. The active
       card sits close in height to the pair rather than floating well
       above them. */
    padding: 3% 4%;
    margin: -3% -4%;
  }

  .hero-slide {
    padding: 0;
    cursor: default;
    transform: translate3d(0, 3%, -180px) scale(0.78);
    opacity: 0;
    filter: blur(3px) brightness(0.6) saturate(0.85);
    box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s ease,
      filter 0.5s ease,
      box-shadow 0.5s ease;
    will-change: transform, opacity, filter;
    z-index: 0;
    pointer-events: none;
    backface-visibility: hidden;
  }

  /* The focal card: front, centred, sitting just slightly above the
     background pair, fully bright and sharp. */
  .hero-slide[data-position='active'] {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    cursor: default;
    transform: translate3d(0, -1.5%, 0) scale(1) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    opacity: 1;
    filter: blur(0) brightness(1) saturate(1);
    box-shadow: 0 24px 44px -18px rgba(0, 0, 0, 0.45), 0 8px 18px -10px rgba(0, 0, 0, 0.3);
    z-index: 30;
    pointer-events: auto;
  }

  .hero-slide[data-position='active'].is-tilting {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.45s ease, filter 0.5s ease, box-shadow 0.5s ease;
  }

  /* Subdued background pair — smaller, dimmer, softly blurred, sitting
     just below and behind the active card. */
  .hero-slide[data-position='prev'] {
    cursor: pointer;
    transform: translate3d(-56%, 2%, -110px) scale(0.86) rotateY(6deg);
    opacity: 0.6;
    filter: blur(1.5px) brightness(0.65) saturate(0.8);
    box-shadow: 0 14px 26px -16px rgba(0, 0, 0, 0.35);
    z-index: 15;
    pointer-events: auto;
  }

  .hero-slide[data-position='next'] {
    cursor: pointer;
    transform: translate3d(56%, 2%, -110px) scale(0.86) rotateY(-6deg);
    opacity: 0.6;
    filter: blur(1.5px) brightness(0.65) saturate(0.8);
    box-shadow: 0 14px 26px -16px rgba(0, 0, 0, 0.35);
    z-index: 15;
    pointer-events: auto;
  }

  .hero-slide[data-position='prev']:hover,
  .hero-slide[data-position='next']:hover {
    opacity: 0.8;
    filter: blur(0.5px) brightness(0.78) saturate(0.9);
  }

  /* Fully out of the stack — parked small and invisible at the back,
     ready to rise into "next" or "prev" on the following transition. */
  .hero-slide[data-position='hidden'] {
    transform: translate3d(0, 3%, -200px) scale(0.76);
    opacity: 0;
    filter: blur(3px) brightness(0.6) saturate(0.85);
    z-index: 0;
    pointer-events: none;
  }

  .hero-slide-img {
    transform: scale(1) translateZ(0);
    transition: transform 8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-slide[data-position='active'] .hero-slide-img {
    transform: scale(1.04) translateZ(0);
  }

  /* Nav arrows */
  .hero-nav {
    position: absolute;
    top: 50%;
    z-index: 40;
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-text) 20%, transparent);
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    color: var(--color-text);
    font-size: 1.25rem;
    line-height: 1;
    backdrop-filter: blur(6px);
    transform: translateY(-50%);
    transition: background-color 0.25s ease, transform 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
    opacity: 0;
  }

  .hero-slider:hover .hero-nav,
  .hero-nav:focus-visible {
    opacity: 1;
  }

  .hero-nav:hover {
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    border-color: color-mix(in srgb, var(--color-text) 40%, transparent);
    transform: translateY(-50%) scale(1.06);
  }

  .hero-nav-prev {
    left: -0.5rem;
  }

  .hero-nav-next {
    right: -0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-slide[data-position='active'],
    .hero-slide[data-position='prev'],
    .hero-slide[data-position='next'],
    .hero-slide[data-position='hidden'] {
      transition: opacity 0.4s ease;
      filter: none;
      transform: none;
    }
  }

  .hero-dot-fill {
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero-dot.is-active {
    background-color: color-mix(in srgb, #C17F2E 35%, transparent);
  }

  .hero-dot.is-active .hero-dot-fill {
    animation: hero-dot-progress 4.5s linear forwards;
  }

  @keyframes hero-dot-progress {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  /*
   * Slow ambient rotation on the certification stamp.
   */

  @keyframes stamp-spin {
    from {
      transform: rotate(-6deg);
    }

    to {
      transform: rotate(354deg);
    }
  }

  .stamp-spin {
    animation: stamp-spin 70s linear infinite;
  }

  /*
   * Respect reduced-motion preferences across the page.
   */

  @media (prefers-reduced-motion: reduce) {
    .ticker-left,
    .ticker-right,
    .animate-fade-up,
    .stamp-spin,
    .hero-dot-fill {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .hero-slide {
      transition: none;
    }

    .hero-slide-img {
      transition: none;
      transform: none;
    }
  }
</style>
