---
import Layout from '../components/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
const products = await getCollection('products');
const contact = await getEntry('contact', 'contact');

const whatsappUrl = `https://wa.me/${contact.data.whatsapp}`;

// Fixed conversion rate (not live) — update this number whenever you want to refresh it
const USD_TO_KSH = 129;
const toUsd = (kshPrice: number) => (Number(kshPrice) / USD_TO_KSH).toFixed(2);

const {
  heading,
  heroEyebrow,
  heroHeadingLine1,
  heroHeadingLine2,
  heroDescription,
  heroCtaPrimaryLabel,
  heroCtaSecondaryLabel,
  heroCtaWhatsappLabel,
  heroLedger,
  tickerRow1,
  tickerRow2,
  productsEyebrow,
  productsHeadingLine1,
  productsHeadingLine2,
  productsDescription,
  productsCtaLabel,
  whySupplyEyebrow,
  whySupplyHeadingLine1,
  whySupplyHeadingLine2,
  whySupplyCards,
  ctaEyebrow,
  ctaHeading,
  ctaDescription,
  ctaPrimaryLabel,
  ctaSecondaryLabel,
} = home.data;
---

<Layout title={heading}>
  <main class="bg-[var(--color-bg)] text-[var(--color-text)]">

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="relative min-h-[85vh] overflow-hidden bg-[var(--color-bg)] text-[var(--color-text)]">

      <img
        src="/public/goat2.png"
        alt="Premium export-ready goat meat"
        class="absolute inset-0 h-full w-full object-cover opacity-25"
      />

      <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg)] via-[color-mix(in_srgb,var(--color-bg)_80%,transparent)] to-[color-mix(in_srgb,var(--color-bg)_40%,transparent)]"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg)] via-transparent to-transparent"></div>

      <!-- signature certification stamp -->
      <div class="stamp-spin pointer-events-none absolute right-6 top-20 hidden h-40 w-40 text-[#C17F2E]/70 sm:block lg:right-16 lg:h-52 lg:w-52">
        <svg viewBox="0 0 160 160" class="h-full w-full">
          <defs>
            <path id="stampRing" d="M 80,80 m -62,0 a 62,62 0 1,1 124,0 a 62,62 0 1,1 -124,0" />
          </defs>
          <circle cx="80" cy="80" r="74" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 5" />
          <circle cx="80" cy="80" r="50" fill="none" stroke="currentColor" stroke-width="1" />
          <text font-size="8.5" letter-spacing="2.5" fill="currentColor" style="font-family: ui-monospace, monospace;">
            <textPath href="#stampRing" startOffset="2%">CERTIFIED &#8226; EXPORT GRADE &#8226; CERTIFIED &#8226; EXPORT GRADE &#8226;</textPath>
          </text>
          <text x="80" y="76" text-anchor="middle" font-size="14" style="font-family: ui-serif, Georgia, serif;" fill="currentColor">EST.</text>
          <text x="80" y="94" text-anchor="middle" font-size="10" letter-spacing="3" style="font-family: ui-monospace, monospace;" fill="currentColor">SAFARI</text>
        </svg>
      </div>

      <div class="relative mx-auto flex min-h-[85vh] max-w-7xl flex-col justify-end px-6 pb-8 pt-4 lg:px-12">

        <!-- HERO CONTENT -->
        <div class="max-w-5xl pb-16 pt-6 lg:pb-24 lg:pt-8">

          <div class="animate-fade-up mb-8 flex items-center gap-3 font-mono text-[10px] font-semibold uppercase tracking-[0.35em] text-[#C17F2E] opacity-0 sm:text-xs" style="animation-delay:120ms">

            <span class="h-px w-8 bg-[#C17F2E]"></span>

            {heroEyebrow}

          </div>

          <h1 class="animate-fade-up max-w-5xl font-serif text-[13vw] font-semibold leading-[0.92] tracking-[-0.03em] opacity-0 sm:text-7xl lg:text-[6.25rem]" style="animation-delay:220ms">
            {heroHeadingLine1}
            <br />
            {heroHeadingLine2}
          </h1>

          <p class="animate-fade-up mt-8 max-w-2xl text-base leading-7 text-[color-mix(in_srgb,var(--color-text)_65%,transparent)] opacity-0 sm:text-lg sm:leading-8" style="animation-delay:340ms">
            {heroDescription}
          </p>

          <div class="animate-fade-up mt-10 flex flex-wrap items-center gap-4 opacity-0" style="animation-delay:460ms">

            <a
              href="/quote"
              class="group inline-flex items-center gap-4 rounded-full bg-[#C17F2E] px-7 py-4 text-sm font-semibold text-[#211C16] transition duration-300 hover:-translate-y-0.5 hover:bg-[#DDA556] hover:shadow-xl hover:shadow-[#C17F2E]/10"
            >
              {heroCtaPrimaryLabel}

              <span
                aria-hidden="true"
                class="transition-transform duration-300 group-hover:translate-x-1"
              >
                →
              </span>
            </a>

            <a
              href="/products"
              class="inline-flex items-center gap-2 rounded-full border border-dashed border-[color-mix(in_srgb,var(--color-text)_25%,transparent)] px-7 py-4 text-sm font-semibold text-[var(--color-text)] backdrop-blur transition duration-300 hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--color-text)_50%,transparent)] hover:bg-[color-mix(in_srgb,var(--color-text)_5%,transparent)]"
            >
              {heroCtaSecondaryLabel}
            </a>

            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-4 font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#C17F2E] transition hover:text-[#DDA556]"
            >
              {heroCtaWhatsappLabel} →
            </a>

          </div>

        </div>


        <!-- HERO LEDGER -->
        <div class="animate-fade-up grid grid-cols-2 gap-6 border-t border-dashed border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] py-6 font-mono opacity-0 sm:grid-cols-4" style="animation-delay:580ms">

          {heroLedger.map((item) => (
            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-[color-mix(in_srgb,var(--color-text)_40%,transparent)]">
                {item.number} &#8226; {item.category}
              </p>

              <p class="mt-1.5 text-sm font-medium text-[color-mix(in_srgb,var(--color-text)_90%,transparent)]">
                {item.value}
              </p>
            </div>
          ))}

        </div>

      </div>
    </section>


    <!-- ========================================================= -->
    <!-- MANIFEST STRIP -->
    <!-- ========================================================= -->

    <section class="border-y border-dashed border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] bg-[var(--color-bg)] py-5">

      <div class="space-y-3">

        <!-- ROW ONE — MOVES LEFT -->
        <div class="ticker-mask relative overflow-hidden">

          <div class="ticker-left flex w-max items-center whitespace-nowrap">

            {Array(4).fill(0).map(() => (
              <div class="flex items-center">

                {tickerRow1.map((item) => (
                  <>
                    <span class="mx-6 font-mono text-[10px] font-medium uppercase tracking-[0.3em] text-[color-mix(in_srgb,var(--color-text)_45%,transparent)] sm:text-xs">
                      {item}
                    </span>

                    <span class="h-1 w-1 rounded-full bg-[#C17F2E]/70"></span>
                  </>
                ))}

              </div>
            ))}

          </div>

        </div>


        <!-- ROW TWO — MOVES RIGHT -->
        <div class="ticker-mask relative overflow-hidden">

          <div class="ticker-right flex w-max items-center whitespace-nowrap">

            {Array(4).fill(0).map(() => (
              <div class="flex items-center">

                {tickerRow2.map((item) => (
                  <>
                    <span class="mx-6 font-mono text-[10px] font-medium uppercase tracking-[0.3em] text-[color-mix(in_srgb,var(--color-text)_25%,transparent)] sm:text-xs">
                      {item}
                    </span>

                    <span class="h-1 w-1 rounded-full bg-[#4B5D42]/50"></span>
                  </>
                ))}

              </div>
            ))}

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- PRODUCTS -->
    <!-- ========================================================= -->

    <section class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">

      <div class="reveal flex flex-col justify-between gap-8 md:flex-row md:items-end">

        <div class="max-w-2xl">

          <div class="flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-[#C17F2E]">

            <span class="h-2 w-2 rotate-45 bg-[#C17F2E]"></span>

            {productsEyebrow}

          </div>

          <h2 class="mt-5 font-serif text-4xl font-semibold leading-[1] tracking-[-0.02em] text-[var(--color-text)] sm:text-5xl lg:text-6xl">
            {productsHeadingLine1}
            <br />
            {productsHeadingLine2}
          </h2>

          <p class="mt-6 max-w-xl text-base leading-7 text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
            {productsDescription}
          </p>

        </div>


        <a
          href="/products"
          class="group inline-flex w-fit items-center gap-3 rounded-full border border-[color-mix(in_srgb,var(--color-text)_20%,transparent)] bg-[var(--color-bg)] px-5 py-3 font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-text)] transition hover:border-[var(--color-text)] hover:bg-[var(--color-text)] hover:text-[var(--color-bg)]"
        >
          {productsCtaLabel}

          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </a>

      </div>


      <!-- PRODUCT GRID -->

      <ul class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">

        {products.map((p, i) => {

          const outOfStock = !p.data.inStock;
          const lot = `LOT-${String(i + 1).padStart(2, '0')}`;

          return (
            <li class="reveal group">

              <a
                href={`/products/${p.slug}`}
                class="block overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_12%,transparent)] bg-[var(--color-bg-soft)] transition duration-500 hover:-translate-y-1 hover:border-[color-mix(in_srgb,var(--color-text)_25%,transparent)] hover:shadow-2xl hover:shadow-black/10"
              >

                <div class="relative aspect-[4/3] overflow-hidden bg-[var(--color-bg-soft-2)]">

                  <img
                    src={p.data.image ?? '/goat.jpeg'}
                    alt={p.data.name}
                    loading="lazy"
                    class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
                  />

                  <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent opacity-0 transition duration-500 group-hover:opacity-100"></div>

                  <span class="absolute left-4 top-4 rounded-full border border-[#211C16]/15 bg-[#211C16]/70 px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.15em] text-[#F2EAD9] backdrop-blur">
                    {lot}
                  </span>

                  {outOfStock && (
                    <span class="absolute right-4 top-4 -rotate-6 rounded-md border border-dashed border-[#9C3B2C] bg-[color-mix(in_srgb,var(--color-bg)_90%,transparent)] px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.15em] text-[#9C3B2C]">
                      Out of Stock
                    </span>
                  )}

                </div>


                <div class="p-6 sm:p-7">

                  <div class="flex items-start justify-between gap-5">

                    <div>

                      <h3 class="font-serif text-xl font-semibold tracking-tight text-[var(--color-text)]">
                        {p.data.name}
                      </h3>

                      <p class="mt-2 flex items-baseline gap-2 font-mono text-sm text-[color-mix(in_srgb,var(--color-text)_50%,transparent)]">
                        <span>Ksh {p.data.pricePerKg} / {p.data.unit}</span>
                        <span class="text-[color-mix(in_srgb,var(--color-text)_35%,transparent)]">
                          (${toUsd(p.data.pricePerKg)})
                        </span>
                      </p>

                    </div>

                    <span
                      aria-hidden="true"
                      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] text-[color-mix(in_srgb,var(--color-text)_50%,transparent)] transition duration-300 group-hover:border-[#C17F2E] group-hover:bg-[#C17F2E] group-hover:text-[#211C16]"
                    >
                      ↗
                    </span>

                  </div>

                  <div class="mt-7 border-t border-dashed border-[color-mix(in_srgb,var(--color-text)_12%,transparent)] pt-5">

                    <span class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[color-mix(in_srgb,var(--color-text)_50%,transparent)] transition group-hover:text-[#C17F2E]">
                      View product details
                    </span>

                  </div>

                </div>

              </a>

            </li>
          );

        })}

      </ul>

    </section>


    <!-- ========================================================= -->
    <!-- WHY SAFARI MEAT -->
    <!-- ========================================================= -->

    <section class="border-y border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[var(--color-bg-soft)]">

      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-28">

        <div class="reveal grid gap-16 lg:grid-cols-[0.8fr_1.2fr]">

          <div>

            <div class="flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-[#C17F2E]">

              <span class="h-2 w-2 rotate-45 bg-[#C17F2E]"></span>

              {whySupplyEyebrow}

            </div>

            <h2 class="mt-5 max-w-md font-serif text-4xl font-semibold leading-tight tracking-[-0.02em] text-[var(--color-text)] sm:text-5xl">
              {whySupplyHeadingLine1}
              <br />
              {whySupplyHeadingLine2}
            </h2>

          </div>


          <div class="grid gap-px overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_12%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_10%,transparent)] sm:grid-cols-2">

            {whySupplyCards.map((card) => (
              <div class="bg-[var(--color-bg)] p-8">

                <span class="font-mono text-xs font-semibold tracking-[0.15em] text-[#C17F2E]">
                  {card.code}
                </span>

                <h3 class="mt-12 font-serif text-xl font-semibold">
                  {card.title}
                </h3>

                <p class="mt-3 text-sm leading-6 text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
                  {card.description}
                </p>

              </div>
            ))}

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- FINAL CTA -->
    <!-- ========================================================= -->

    <section class="relative overflow-hidden bg-[var(--color-bg)] text-[var(--color-text)]">

      <div class="pointer-events-none absolute -bottom-16 -right-16 hidden h-56 w-56 rotate-12 text-[#4B5D42]/40 sm:block">
        <svg viewBox="0 0 160 160" class="h-full w-full">
          <defs>
            <path id="stampRing2" d="M 80,80 m -62,0 a 62,62 0 1,1 124,0 a 62,62 0 1,1 -124,0" />
          </defs>
          <circle cx="80" cy="80" r="74" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 5" />
          <circle cx="80" cy="80" r="50" fill="none" stroke="currentColor" stroke-width="1" />
          <text font-size="8.5" letter-spacing="2.5" fill="currentColor" style="font-family: ui-monospace, monospace;">
            <textPath href="#stampRing2" startOffset="2%">HALAL CERTIFIED &#8226; COLD CHAIN &#8226; HALAL CERTIFIED &#8226;</textPath>
          </text>
        </svg>
      </div>

      <div class="relative mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">

        <div class="reveal grid items-end gap-12 lg:grid-cols-[1.2fr_0.8fr]">

          <div>

            <div class="flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.28em] text-[#C17F2E]">

              <span class="h-px w-7 bg-[#C17F2E]"></span>

              {ctaEyebrow}

            </div>

            <h2 class="mt-6 max-w-4xl font-serif text-4xl font-semibold leading-[0.98] tracking-[-0.02em] sm:text-5xl lg:text-7xl">
              {ctaHeading}
            </h2>

          </div>


          <div>

            <p class="max-w-md text-base leading-7 text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              {ctaDescription}
            </p>


            <div class="mt-8 flex flex-wrap gap-3">

              <a
                href="/quote"
                class="group inline-flex items-center gap-4 rounded-full bg-[#C17F2E] px-7 py-4 text-sm font-semibold text-[#211C16] transition hover:bg-[#DDA556]"
              >
                {ctaPrimaryLabel}

                <span
                  aria-hidden="true"
                  class="transition-transform duration-300 group-hover:translate-x-1"
                >
                  →
                </span>
              </a>


              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-full border border-dashed border-[color-mix(in_srgb,var(--color-text)_25%,transparent)] px-7 py-4 text-sm font-semibold text-[var(--color-text)] backdrop-blur transition hover:border-[color-mix(in_srgb,var(--color-text)_50%,transparent)] hover:bg-[color-mix(in_srgb,var(--color-text)_5%,transparent)]"
              >
                {ctaSecondaryLabel}
              </a>

            </div>

          </div>

        </div>

      </div>

    </section>

  </main>
</Layout>

<script>
  // astro:page-load fires on every navigation (first load and every
  // client-side route swap), so scroll-reveal keeps working when this page
  // is revisited later in the same session.
  document.addEventListener('astro:page-load', () => {
    const revealEls = document.querySelectorAll('.reveal');

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    );

    revealEls.forEach((el) => observer.observe(el));
  });
</script>

<style>
  /*
   * Manifest strip — slow, ambient drift rather than a busy marquee.
   */

  .ticker-left {
    animation: ticker-left 140s linear infinite;
  }

  .ticker-right {
    animation: ticker-right 160s linear infinite;
  }

  @keyframes ticker-left {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-25%);
    }
  }

  @keyframes ticker-right {
    from {
      transform: translateX(-25%);
    }

    to {
      transform: translateX(0);
    }
  }

  /* Fade the strip out at both edges instead of a hard clip */
  .ticker-mask {
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  /*
   * Pause both rows when the user hovers over them.
   */

  .ticker-left:hover,
  .ticker-right:hover {
    animation-play-state: paused;
  }

  /*
   * Hero entrance — staggered fade + rise, driven by inline animation-delay.
   */

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-up {
    animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /*
   * Scroll reveal for sections below the fold.
   */

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /*
   * Slow ambient rotation on the certification stamp.
   */

  @keyframes stamp-spin {
    from {
      transform: rotate(-6deg);
    }

    to {
      transform: rotate(354deg);
    }
  }

  .stamp-spin {
    animation: stamp-spin 70s linear infinite;
  }

  /*
   * Respect reduced-motion preferences across the page.
   */

  @media (prefers-reduced-motion: reduce) {
    .ticker-left,
    .ticker-right,
    .animate-fade-up,
    .stamp-spin {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
