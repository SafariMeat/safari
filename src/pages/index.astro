---
import Layout from '../components/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
const products = await getCollection('products');
const contact = await getEntry('contact', 'contact');
const whatsappUrl = `https://wa.me/${contact.data.whatsapp}`;
---

<Layout title={home.data.heading}>
  <main class="bg-[#f7f4ee] text-stone-900">

    <!-- HERO -->
    <section class="relative overflow-hidden bg-stone-950 text-stone-50">
      <img
        src="/images/hero-goat-meat.jpg"
        alt="Premium export-ready goat meat, packaged and chilled"
        class="absolute inset-0 h-full w-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-stone-950/40 via-stone-950/70 to-stone-950"></div>

      <div class="relative mx-auto flex min-h-[92vh] max-w-7xl flex-col justify-end px-6 pb-20 pt-40 lg:px-12">
        <div class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.3em] text-emerald-400">
          <span class="h-px w-8 bg-emerald-400"></span>
          East African Meat Exporters
        </div>

        <h1 class="mt-8 max-w-4xl text-[13vw] font-semibold leading-[0.95] tracking-tight sm:text-6xl lg:text-7xl">
          {home.data.heading}
        </h1>

        <p class="mt-8 max-w-xl text-base text-stone-300 sm:text-lg">
          Premium, export-ready goat meat supplied to international wholesale buyers —
          quality-controlled sourcing, professional packaging and cold-chain handling
          from East Africa to your market.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-6">
          
            href="/quote"
            class="group inline-flex items-center gap-3 rounded-full bg-emerald-600 px-7 py-4 text-sm font-semibold text-white transition hover:bg-emerald-500"
          >
            Request a Quotation
            <span class="transition group-hover:translate-x-1">→</span>
          </a>
          
            href="/products"
            class="text-sm font-semibold text-stone-100 underline decoration-stone-500 underline-offset-4 transition hover:decoration-emerald-400"
          >
            View Our Products
          </a>
          
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-emerald-400 transition hover:text-emerald-300"
          >
            WhatsApp Us
          </a>
        </div>
      </div>

      <!-- marquee strip -->
      <div class="relative border-t border-stone-800 bg-stone-950/80 py-3 backdrop-blur">
        <div class="flex animate-[scroll_28s_linear_infinite] whitespace-nowrap text-xs font-medium uppercase tracking-[0.3em] text-stone-400">
          {Array(3).fill(0).map(() => (
            <span class="mx-6 flex items-center gap-6">
              <span>Halal Certified</span>
              <span class="text-emerald-500">•</span>
              <span>Cold-Chain Handling</span>
              <span class="text-emerald-500">•</span>
              <span>Export Documentation</span>
              <span class="text-emerald-500">•</span>
              <span>Professional Packaging</span>
              <span class="text-emerald-500">•</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section class="mx-auto max-w-7xl px-6 py-28 lg:px-12">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700">
            Our Products
          </span>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight text-stone-900 sm:text-5xl">
            Premium Goat Meat,<br />Export Ready
          </h2>
        </div>
        
          href="/products"
          class="shrink-0 text-sm font-semibold text-emerald-700 underline underline-offset-4 transition hover:text-emerald-600"
        >
          View all products →
        </a>
      </div>

      <ul class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-stone-200 bg-stone-200 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => {
          const outOfStock = !p.data.inStock;
          return (
            <li class="group relative bg-[#f7f4ee] transition hover:bg-white">
              <a href={`/products/${p.slug}`} class="flex h-full flex-col">
                <div class="relative aspect-[4/3] overflow-hidden">
                  <img
                    src={p.data.image ?? '/images/product-placeholder.jpg'}
                    alt={p.data.name}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                  />
                  {outOfStock && (
                    <span class="absolute left-4 top-4 rounded-full bg-stone-950/85 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest text-white">
                      Out of Stock
                    </span>
                  )}
                </div>

                <div class="flex flex-1 flex-col justify-between p-7">
                  <div>
                    <h3 class="text-xl font-semibold text-stone-900">{p.data.name}</h3>
                    <p class="mt-2 text-sm text-stone-500">
                      Ksh {p.data.pricePerKg} / {p.data.unit}
                    </p>
                  </div>
                  <span class="mt-6 inline-flex items-center text-sm font-semibold text-emerald-700 transition group-hover:gap-2">
                    View details <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- FINAL CTA -->
    <section class="bg-stone-950 text-stone-50">
      <div class="mx-auto max-w-7xl px-6 py-28 lg:px-12">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <h2 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
            Looking for a reliable East African goat meat supplier?
          </h2>
          <div>
            <p class="max-w-md text-stone-400">
              Request product specifications, pricing, quantities and shipping
              information — our team responds promptly to wholesale enquiries.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              
                href="/quote"
                class="rounded-full bg-emerald-600 px-7 py-4 text-sm font-semibold text-white transition hover:bg-emerald-500"
              >
                Request a Quote
              </a>
              
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-stone-700 px-7 py-4 text-sm font-semibold text-stone-100 transition hover:border-stone-500"
              >
                Contact Sales
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }
</style>