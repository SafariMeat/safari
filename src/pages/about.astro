---
import Layout from '../components/Layout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('about', 'about');
const {
  heading,
  tagline,
  heroDescription,
  whoWeAreTitle,
  whoWeAreDescription,
  whoWeArePoints,
  missionTitle,
  missionDescription,
  whyWorkWithUsTitle,
  whyWorkWithUs,
  qualityCommitmentTitle,
  qualityCommitmentDescription,
  exportReadinessTitle,
  exportReadinessDescription,
  exportReadinessPoints,
} = entry.data;
---

<Layout title={heading}>
  <main class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)]">
    <!-- Hero -->
    <section class="px-4 pt-14 pb-10 sm:pt-20 sm:pb-14">
      <div class="mx-auto w-full max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-[color-mix(in_srgb,var(--color-accent)_80%,transparent)]">
          {tagline}
        </p>
        <h1 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)]">
          {heading}
        </h1>
        <p class="mt-5 text-base sm:text-lg leading-relaxed text-[color-mix(in_srgb,var(--color-text)_60%,transparent)]">
          {heroDescription}
        </p>
      </div>
    </section>

    <div class="mx-auto w-full max-w-3xl px-4 pb-16 sm:pb-24 space-y-6">
      <!-- Company background / what we do -->
      <section class="rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] backdrop-blur-sm shadow-xl shadow-black/30 p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-text)]">{whoWeAreTitle}</h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[color-mix(in_srgb,var(--color-text)_80%,transparent)]">
          {whoWeAreDescription}
        </p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {whoWeArePoints.map((point) => (
            <li class="flex items-start gap-2.5 text-sm text-[color-mix(in_srgb,var(--color-text)_80%,transparent)]">
              <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Mission -->
      <section class="rounded-2xl border border-[color-mix(in_srgb,var(--color-accent)_20%,transparent)] bg-gradient-to-br from-[color-mix(in_srgb,var(--color-accent)_7%,transparent)] to-transparent p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-text)]">{missionTitle}</h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[color-mix(in_srgb,var(--color-text)_80%,transparent)]">
          {missionDescription}
        </p>
      </section>

      <!-- Why work with us -->
      <section>
        <h2 class="px-1 text-xl sm:text-2xl font-semibold text-[var(--color-text)]">{whyWorkWithUsTitle}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {whyWorkWithUs.map((item) => (
            <div class="rounded-xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] p-5 transition hover:border-[color-mix(in_srgb,var(--color-accent)_30%,transparent)] hover:bg-[color-mix(in_srgb,var(--color-text)_5%,transparent)]">
              <h3 class="text-sm font-semibold text-[var(--color-accent)]">{item.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[color-mix(in_srgb,var(--color-text)_60%,transparent)]">{item.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Quality commitment -->
      <section class="rounded-2xl border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_3%,transparent)] backdrop-blur-sm shadow-xl shadow-black/30 p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-text)]">{qualityCommitmentTitle}</h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[color-mix(in_srgb,var(--color-text)_80%,transparent)]">
          {qualityCommitmentDescription}
        </p>
      </section>

      <!-- Export readiness -->
      <section class="rounded-2xl border border-[color-mix(in_srgb,var(--color-accent)_20%,transparent)] bg-gradient-to-br from-[color-mix(in_srgb,var(--color-accent)_7%,transparent)] to-transparent p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-semibold text-[var(--color-text)]">{exportReadinessTitle}</h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-[color-mix(in_srgb,var(--color-text)_80%,transparent)]">
          {exportReadinessDescription}
        </p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {exportReadinessPoints.map((point) => (
            <li class="flex items-start gap-2.5 text-sm text-[color-mix(in_srgb,var(--color-text)_80%,transparent)]">
              <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-accent)]"></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</Layout>
