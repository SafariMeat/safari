---
// Site-wide shell: nav + footer, per proposal section 2.11.
import { getEntry } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/products', label: 'Products' },
  { href: '/export-certification', label: 'Export & Certification' },
  { href: '/markets', label: 'Markets' },
  { href: '/wholesale', label: 'Wholesale' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact' },
  { href: '/quote', label: 'Request a Quote' },
];

const footerLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/products', label: 'Products' },
  { href: '/export-certification', label: 'Export & Certification' },
  { href: '/markets', label: 'Markets' },
  { href: '/wholesale', label: 'Wholesale' },
  { href: '/export-process', label: 'Our Export Process' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/quote', label: 'Request a Quote' },
  { href: '/contact', label: 'Contact' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Safari Meat Exports</title>
  </head>
  <body class="bg-neutral-950 text-neutral-100">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-neutral-950/80 backdrop-blur-md">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" class="flex items-center gap-2 text-white">
          <span class="text-lg font-bold tracking-tight">
            Safari<span class="text-amber-500">Meat</span>
          </span>
          <span class="hidden text-xs uppercase tracking-[0.2em] text-neutral-500 sm:inline">
            Exports
          </span>
        </a>

        <!-- Desktop nav -->
        <div class="hidden items-center gap-1 lg:flex">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-neutral-300 transition hover:bg-white/[0.06] hover:text-white"
            >
              {link.label}
            </a>
          ))}
          <a
            href="/order"
            class="ml-2 inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-3.5 py-2 text-sm font-semibold text-neutral-950 transition hover:bg-amber-400"
          >
            Your Order
            <span
              id="nav-cart-count"
              class="inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-neutral-950/20 px-1.5 py-0.5 text-xs font-bold"
            >
              0
            </span>
          </a>
        </div>

        <!-- Mobile controls -->
        <div class="flex items-center gap-2 lg:hidden">
          <a
            href="/order"
            class="inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-3 py-1.5 text-sm font-semibold text-neutral-950"
          >
            Order
            <span
              id="nav-cart-count-mobile"
              class="inline-flex min-w-[1.1rem] items-center justify-center rounded-full bg-neutral-950/20 px-1.5 py-0.5 text-xs font-bold"
            >
              0
            </span>
          </a>
          <button
            id="mobile-menu-button"
            type="button"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-white/10 text-neutral-200 transition hover:bg-white/[0.06]"
          >
            <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-white/10 lg:hidden">
        <div class="space-y-0.5 px-4 py-3 sm:px-6">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="block rounded-md px-3 py-2.5 text-sm font-medium text-neutral-300 transition hover:bg-white/[0.06] hover:text-white"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </header>

    <slot />

    <footer class="border-t border-white/10 bg-neutral-950">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <div class="grid gap-10 sm:grid-cols-3">
          <div>
            <span class="text-lg font-bold tracking-tight text-white">
              Safari<span class="text-amber-500">Meat</span>
            </span>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-neutral-400">
              East African meat sourcing and export, built on quality, professional
              handling, and reliable supply relationships.
            </p>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Explore
            </h3>
            <nav class="mt-4 flex flex-col gap-2.5">
              {footerLinks.map((link) => (
                <a
                  href={link.href}
                  class="text-sm text-neutral-400 transition hover:text-amber-400"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
              Your Order
            </h3>
            <a
              href="/order"
              class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/[0.04] px-3.5 py-2 text-sm font-medium text-white transition hover:bg-white/[0.08]"
            >
              View Order
              <span
                id="nav-cart-count-footer"
                class="inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-amber-500/20 px-1.5 py-0.5 text-xs font-bold text-amber-400"
              >
                0
              </span>
            </a>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs text-neutral-500">
            &copy; {new Date().getFullYear()} Safari Meats — East African Meat Exporters
          </p>
          <div class="flex gap-5 text-xs text-neutral-500">
            <a href="/privacy" class="transition hover:text-neutral-300">Privacy Policy</a>
            <a href="/terms" class="transition hover:text-neutral-300">Terms &amp; Conditions</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  // Keeps the "Your Order (N)" badge in the header/footer nav in sync with
  // the cart on every page, not just the order page itself. cartCount() was
  // previously exported from cart.ts but never called anywhere — this is
  // that call site.
  import { getCart, cartCount, CART_CHANGED_EVENT } from '../lib/cart';

  function updateCartBadge() {
    const count = cartCount(getCart());
    for (const id of ['nav-cart-count', 'nav-cart-count-mobile', 'nav-cart-count-footer']) {
      const el = document.getElementById(id);
      if (el) el.textContent = String(count);
    }
  }

  updateCartBadge();

  // Same-tab updates (adding an item, editing qty on the order page, etc.)
  window.addEventListener(CART_CHANGED_EVENT, updateCartBadge);
  // Cross-tab updates (cart changed in another open tab/window).
  window.addEventListener('storage', (e) => {
    if (e.key === null || e.key === 'safari-meats-cart') updateCartBadge();
  });

  // Mobile menu toggle.
  const menuButton = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  menuButton?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    menuButton.setAttribute('aria-expanded', String(!!isHidden));
  });

  // Close the mobile menu when a nav link is tapped.
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>