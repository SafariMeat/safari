---
// Site-wide shell: nav + footer, per proposal section 2.11.
import { getEntry } from 'astro:content';
import { ViewTransitions } from 'astro:transitions';
import type { TransitionAnimationValue } from 'astro:transitions';
import '../styles/global.css';

// Different pages get different transitions, categorized by what kind of
// page they are — rather than one animation reused everywhere:
//
//   Home           → cinematic zoom (it's the hub you launch from / land on)
//   Informational  → direction-aware horizontal slide (About, Products,
//                    Markets, Gallery, Export pages) — feels like flipping
//                    through pages of a book. Astro auto-detects browser
//                    back navigation and swaps in the "backwards" pair below,
//                    so the slide direction reverses naturally.
//   Task pages     → content rises up like a focused sheet (Wholesale,
//                    Contact, Quote, Order) — sets "do something" pages
//                    apart from pages you just read.
//   Utility/legal  → quick, quiet fade (Terms, Privacy) — no drama needed.
//
// Keyframes for all of these live in the global <style> block below. Only
// the #page-content wrapper animates — header/footer are transition:persist'd.
type Anim = { name: string; duration?: string; easing?: string; fillMode?: string };
type Pair = { old: Anim; new: Anim };

const zoomPair: Pair = {
  old: { name: 'zoom-out', duration: '0.3s', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
  new: { name: 'zoom-in', duration: '0.45s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
};

const slideForwardPair: Pair = {
  old: { name: 'slide-out-left', duration: '0.32s', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
  new: { name: 'slide-in-right', duration: '0.38s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
};
const slideBackwardPair: Pair = {
  old: { name: 'slide-out-right', duration: '0.32s', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
  new: { name: 'slide-in-left', duration: '0.38s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
};

const risePair: Pair = {
  old: { name: 'rise-out', duration: '0.24s', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
  new: { name: 'rise-in', duration: '0.4s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
};

const quickFadePair: Pair = {
  old: { name: 'quick-fade-out', duration: '0.15s', easing: 'ease-out', fillMode: 'both' },
  new: { name: 'quick-fade-in', duration: '0.2s', easing: 'ease-out', fillMode: 'both' },
};

const taskPages = ['/wholesale', '/contact', '/quote', '/order'];
const utilityPages = ['/terms', '/privacy'];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const pageTransition: TransitionAnimationValue =
  path === '/'
    ? { forwards: zoomPair, backwards: zoomPair }
    : taskPages.includes(path)
      ? { forwards: risePair, backwards: risePair }
      : utilityPages.includes(path)
        ? { forwards: quickFadePair, backwards: quickFadePair }
        : { forwards: slideForwardPair, backwards: slideBackwardPair }; // about, products, markets, gallery, export-*

interface Props {
  title: string;
}

const { title } = Astro.props;

// Contact numbers for the floating call/WhatsApp launcher below.
const contactEntry = await getEntry('contact', 'contact');
const contactPhone = contactEntry?.data.phone ?? '';
const contactWhatsapp = contactEntry?.data.whatsapp ?? contactPhone;
const whatsappDigits = contactWhatsapp.replace(/[^\d]/g, '');
const telHref = `tel:${contactPhone.replace(/\s+/g, '')}`;
const whatsappHref = `https://wa.me/${whatsappDigits}`;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/products', label: 'Products' },
  { href: '/wholesale', label: 'Wholesale' },
  { href: '/contact', label: 'Contact' },
  { href: '/quote', label: 'Request a Quote' },
];

const footerLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/products', label: 'Products' },
  { href: '/wholesale', label: 'Wholesale' },
  { href: '/quote', label: 'Request a Quote' },
  { href: '/contact', label: 'Contact' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Tells mobile browsers exactly what color to tint the system UI
      (Safari's bottom bar, Chrome for Android's nav bar) instead of
      letting them live-sample the page background. Without this, the
      browser re-samples the animating background-color during the
      dark/light transition and the system bar flickers as a result.
      Updated instantly (no transition) whenever the theme is toggled —
      see the setTheme() script below.
    -->
    <meta name="theme-color" id="theme-color-meta" content="#0b0c0e" />
    <title>{title} — Safari Meat Exports</title>

    <!-- Enables smooth, SPA-style page transitions for every internal link
         on the site (astro:transitions). No per-page setup needed. -->
    <ViewTransitions />

    <!--
      Theme tokens: two brand palettes (not literal black/white) toggled via
      [data-theme] on <html>. Dark is the default (no attribute needed) so
      first-time visitors get dark mode with zero JS/flash. Alpha variants
      throughout the site are expressed with color-mix() against these two
      base colors, so every /NN opacity used on a page carries over exactly
      to whichever theme is active instead of needing a light AND dark
      version of every shade.

      Palette: neutral-950/neutral-100 dark, neutral-50/neutral-900 light,
      amber accent (500 on dark, 600 on light for contrast).
    -->
    <style is:global>
      :root {
        --color-bg: #0b0c0e;              /* deep charcoal, cooler than flat black */
        --color-bg-soft: #16181b;         /* raised surface */
        --color-bg-soft-2: #212327;       /* raised surface, more contrast */
        --color-text: #f2efe9;            /* warm off-white, pairs with bronze accent */
        --color-accent: #c17f2e;          /* bronze — matches hero stamp/CTA for a unified palette */
        --color-accent-soft: #dda556;     /* lighter bronze — hover states, glows */
        --color-accent-contrast: #17130c; /* text sitting on accent bg */

        /* Semantic colors, tuned to sit next to the bronze/charcoal palette
           instead of stock Tailwind neon green/red (which read as generic
           and clash with the warm, earthy hue of the accent). */
        --color-success: #3f9d67;         /* muted forest green */
        --color-success-hover: #4db479;
        --color-success-contrast: #f2efe9;
        --color-danger: #d97757;          /* warm terracotta red */
        --color-danger-hover: #e28b6c;
        color-scheme: dark;
      }

      :root[data-theme='light'] {
        --color-bg: #fbf8f2;              /* warm linen/ivory — softer than a flat off-white */
        --color-bg-soft: #f4efe2;         /* parchment card surface */
        --color-bg-soft-2: #e8e0cd;       /* deeper parchment for borders/hover, more tonal presence */
        --color-text: #241f19;            /* rich espresso, warmer & softer than near-black */
        --color-accent: #9a5c1c;          /* burnished copper, AA on ivory (5.05:1) */
        --color-accent-soft: #c17f2e;     /* honey-bronze — hover glows, echoes the dark theme's accent */
        --color-accent-contrast: #fffaf0;

        --color-success: #3f7d52;         /* muted sage, quieter/more elegant than forest green */
        --color-success-hover: #336343;
        --color-success-contrast: #fbf8f2;
        --color-danger: #b1543c;          /* soft clay-red, warmer and less harsh than terracotta */
        --color-danger-hover: #954732;
        color-scheme: light;
      }

      html {
        background-color: var(--color-bg);
      }

      body {
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      .theme-icon-sun {
        display: none;
      }
      .theme-icon-moon {
        display: block;
      }
      [data-theme='light'] .theme-icon-sun {
        display: block;
      }
      [data-theme='light'] .theme-icon-moon {
        display: none;
      }

      /*
        Keyframes referenced by the transition pairs defined above (applied
        to #page-content via transition:animate). Astro generates the scoped
        ::view-transition-old/new(page-content) rules that point at these
        names — we only define the motion itself here.
      */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }

      /* Home: cinematic zoom. */
      @keyframes zoom-out {
        from { opacity: 1; transform: scale(1); }
        to { opacity: 0; transform: scale(0.97); }
      }
      @keyframes zoom-in {
        from { opacity: 0; transform: scale(1.04); }
        to { opacity: 1; transform: scale(1); }
      }

      /* Informational pages: direction-aware horizontal slide. */
      @keyframes slide-out-left {
        from { opacity: 1; transform: translateX(0); }
        to { opacity: 0; transform: translateX(-40px); }
      }
      @keyframes slide-in-right {
        from { opacity: 0; transform: translateX(40px); }
        to { opacity: 1; transform: translateX(0); }
      }
      @keyframes slide-out-right {
        from { opacity: 1; transform: translateX(0); }
        to { opacity: 0; transform: translateX(40px); }
      }
      @keyframes slide-in-left {
        from { opacity: 0; transform: translateX(-40px); }
        to { opacity: 1; transform: translateX(0); }
      }

      /* Task pages (forms/checkout): rises up like a focused sheet. */
      @keyframes rise-out {
        from { opacity: 1; transform: translateY(0) scale(1); }
        to { opacity: 0; transform: translateY(-10px) scale(0.98); }
      }
      @keyframes rise-in {
        from { opacity: 0; transform: translateY(28px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }

      /* Utility/legal pages: quick, quiet fade. */
      @keyframes quick-fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }
      @keyframes quick-fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    </style>

    <!--
      Applies a saved "light" preference before first paint.

      Runs on the initial load AND on 'astro:after-swap'. With
      astro:transitions enabled, client-side navigations swap the <html>
      element's attributes to match the freshly-fetched page — which wipes
      out any data-theme we'd previously set via JS, since the server-
      rendered markup never includes it. Re-running this on every swap
      (before the browser paints the new page) puts it back, so a light-
      mode choice survives navigation instead of reverting to dark.
    -->
    <script is:inline>
      (function () {
        function applyStoredTheme() {
          try {
            var stored = localStorage.getItem('safari-meats-theme');
            if (stored === 'light') {
              document.documentElement.setAttribute('data-theme', 'light');
              var meta = document.getElementById('theme-color-meta');
              if (meta) meta.setAttribute('content', '#fbf8f2');
            } else {
              document.documentElement.removeAttribute('data-theme');
              var metaEl = document.getElementById('theme-color-meta');
              if (metaEl) metaEl.setAttribute('content', '#0b0c0e');
            }
          } catch (e) {}
        }
        applyStoredTheme();
        document.addEventListener('astro:after-swap', applyStoredTheme);
      })();
    </script>
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text)]">
    <header
      transition:persist
      transition:name="site-header"
      class="sticky top-0 z-50 border-b border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_80%,transparent)] backdrop-blur-md">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" class="flex items-center gap-2 text-[var(--color-text)]">
          <span class="text-lg font-bold tracking-tight">
            Safari<span class="text-[var(--color-accent)]">Meat</span>
          </span>
          <span class="hidden text-xs uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-text)_45%,transparent)] sm:inline">
            Exports
          </span>
        </a>

        <!-- Desktop nav -->
        <div class="hidden items-center gap-1 lg:flex">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-[color-mix(in_srgb,var(--color-text)_70%,transparent)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)] hover:text-[var(--color-text)]"
            >
              {link.label}
            </a>
          ))}

          <button
            type="button"
            class="theme-toggle ml-1 inline-flex h-9 w-9 items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)]"
            aria-label="Toggle color theme"
          >
            <svg class="theme-icon-sun h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.36 6.36l-1.06-1.06M6.7 6.7 5.64 5.64m12.72 0-1.06 1.06M6.7 17.3l-1.06 1.06M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z" />
            </svg>
            <svg class="theme-icon-moon h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
            </svg>
          </button>

          <a
            href="/order"
            class="ml-2 inline-flex items-center gap-1.5 rounded-lg bg-[var(--color-accent)] px-3.5 py-2 text-sm font-semibold text-[var(--color-accent-contrast)] transition hover:brightness-110"
          >
            Your Order
            <span
              id="nav-cart-count"
              class="inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-black/20 px-1.5 py-0.5 text-xs font-bold"
            >
              0
            </span>
          </a>
        </div>

        <!-- Mobile controls -->
        <div class="flex items-center gap-2 lg:hidden">
          <button
            type="button"
            class="theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)]"
            aria-label="Toggle color theme"
          >
            <svg class="theme-icon-sun h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.36 6.36l-1.06-1.06M6.7 6.7 5.64 5.64m12.72 0-1.06 1.06M6.7 17.3l-1.06 1.06M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z" />
            </svg>
            <svg class="theme-icon-moon h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
            </svg>
          </button>

          <a
            href="/order"
            class="inline-flex items-center gap-1.5 rounded-lg bg-[var(--color-accent)] px-3 py-1.5 text-sm font-semibold text-[var(--color-accent-contrast)]"
          >
            Order
            <span
              id="nav-cart-count-mobile"
              class="inline-flex min-w-[1.1rem] items-center justify-center rounded-full bg-black/20 px-1.5 py-0.5 text-xs font-bold"
            >
              0
            </span>
          </a>
          <button
            id="mobile-menu-button"
            type="button"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)]"
          >
            <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] lg:hidden">
        <div class="space-y-0.5 px-4 py-3 sm:px-6">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="block rounded-md px-3 py-2.5 text-sm font-medium text-[color-mix(in_srgb,var(--color-text)_70%,transparent)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)] hover:text-[var(--color-text)]"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </header>

    <div id="page-content" transition:animate={pageTransition} transition:name="page-content">
      <slot />
    </div>

    <footer
      transition:persist
      transition:name="site-footer"
      class="border-t border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[var(--color-bg)]">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <div class="grid gap-10 sm:grid-cols-3">
          <div>
            <span class="text-lg font-bold tracking-tight text-[var(--color-text)]">
              Safari<span class="text-[var(--color-accent)]">Meat</span>
            </span>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              East African meat sourcing and export, built on quality, professional
              handling, and reliable supply relationships.
            </p>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
              Explore
            </h3>
            <nav class="mt-4 flex flex-col gap-2.5">
              {footerLinks.map((link) => (
                <a
                  href={link.href}
                  class="text-sm text-[color-mix(in_srgb,var(--color-text)_55%,transparent)] transition hover:text-[var(--color-accent)]"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
              Your Order
            </h3>
            <a
              href="/order"
              class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_4%,transparent)] px-3.5 py-2 text-sm font-medium text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_8%,transparent)]"
            >
              View Order
              <span
                id="nav-cart-count-footer"
                class="inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-[color-mix(in_srgb,var(--color-accent)_20%,transparent)] px-1.5 py-0.5 text-xs font-bold text-[var(--color-accent)]"
              >
                0
              </span>
            </a>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-4 border-t border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
            &copy; {new Date().getFullYear()} Safari Meats — East African Meat Exporters
          </p>
          <div class="flex gap-5 text-xs text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
            <!-- <a href="/privacy" class="transition hover:text-[color-mix(in_srgb,var(--color-text)_70%,transparent)]">Privacy Policy</a> -->
            <!-- <a href="/terms" class="transition hover:text-[color-mix(in_srgb,var(--color-text)_70%,transparent)]">Terms &amp; Conditions</a> -->
          </div>
        </div>
      </div>
    </footer>

    <!--
      Fixed bottom-right "contact" launcher, persisted across page
      transitions like the header/footer. A pulsing ring + gentle bob draws
      the eye without being obnoxious; tapping/clicking expands two options
      (Call, WhatsApp) instead of jumping straight to one channel.
    -->
    <div
      id="contact-fab"
      transition:persist
      class="fixed bottom-5 right-5 z-[60] flex flex-col items-end gap-3">
      <!-- Expanded options (hidden by default) -->
      <div
        id="contact-fab-options"
        class="pointer-events-none flex flex-col items-end gap-2.5 opacity-0 translate-y-2 transition-all duration-200 ease-out">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="fab-option pointer-events-auto flex items-center gap-2.5 rounded-full bg-[var(--color-bg-soft)] py-2 pl-4 pr-2.5 text-sm font-medium text-[var(--color-text)] shadow-lg ring-1 ring-[color-mix(in_srgb,var(--color-text)_10%,transparent)] transition hover:bg-[var(--color-bg-soft-2)]">
          WhatsApp Us
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="currentColor">
              <path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.25-1.38A9.96 9.96 0 0 0 12.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm5.8 14.24c-.24.68-1.4 1.32-1.94 1.4-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.16-4.94-4.35-.14-.19-1.18-1.57-1.18-3s.75-2.13 1.02-2.42c.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.82 2 .89 2.15.07.15.12.32.02.51-.1.19-.15.31-.3.48-.14.17-.31.37-.44.5-.15.15-.3.31-.13.6.17.29.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.37 1.47.29.15.46.13.63-.08.17-.2.72-.84.92-1.13.19-.29.39-.24.65-.14.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.73-.16 1.41Z"/>
            </svg>
          </span>
        </a>
        <a
          href={telHref}
          class="fab-option pointer-events-auto flex items-center gap-2.5 rounded-full bg-[var(--color-bg-soft)] py-2 pl-4 pr-2.5 text-sm font-medium text-[var(--color-text)] shadow-lg ring-1 ring-[color-mix(in_srgb,var(--color-text)_10%,transparent)] transition hover:bg-[var(--color-bg-soft-2)]">
          Call Us
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)] text-[var(--color-accent-contrast)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="currentColor">
              <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.4 21 3 13.6 3 4.5a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/>
            </svg>
          </span>
        </a>
      </div>

      <!-- Trigger button -->
      <button
        type="button"
        id="contact-fab-trigger"
        aria-expanded="false"
        aria-label="Contact us: call or WhatsApp"
        class="fab-trigger relative flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-accent)] text-[var(--color-accent-contrast)] shadow-xl transition hover:brightness-110 active:scale-95">
        <span class="fab-ping absolute inset-0 rounded-full bg-[var(--color-accent)] opacity-60"></span>
        <svg id="fab-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="relative h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 10.5a8.25 8.25 0 1 1 5.755 7.86L9 21l1.107-3.68A8.22 8.22 0 0 1 8.25 10.5Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 10.125h.008v.008H8.25v-.008Zm3.75 0h.008v.008H12v-.008Zm3.75 0h.008v.008h-.008v-.008Z" />
        </svg>
        <svg id="fab-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="relative hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <style>
      /* Gentle bob to catch the eye + expanding ring pulse, independent of
         each other so the button never looks jittery. Respects
         prefers-reduced-motion via the global rule already defined above
         for view-transitions — mirrored here for this looping animation. */
      #contact-fab-trigger {
        animation: fab-bob 2.6s ease-in-out infinite;
      }
      .fab-ping {
        animation: fab-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
      }
      @keyframes fab-bob {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
      }
      @keyframes fab-ping {
        0% { transform: scale(1); opacity: 0.55; }
        75%, 100% { transform: scale(1.9); opacity: 0; }
      }
      #contact-fab-options.fab-open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }
      @media (prefers-reduced-motion: reduce) {
        #contact-fab-trigger,
        .fab-ping {
          animation: none;
        }
      }
    </style>
  </body>
</html>

<script>
  // Keeps the "Your Order (N)" badge in the header/footer nav in sync with
  // the cart on every page, not just the order page itself. cartCount() was
  // previously exported from cart.ts but never called anywhere — this is
  // that call site.
  import { getCart, cartCount, CART_CHANGED_EVENT } from '../lib/cart';

  function updateCartBadge() {
    const count = cartCount(getCart());
    for (const id of ['nav-cart-count', 'nav-cart-count-mobile', 'nav-cart-count-footer']) {
      const el = document.getElementById(id);
      if (el) el.textContent = String(count);
    }
  }

  updateCartBadge();

  // Same-tab updates (adding an item, editing qty on the order page, etc.)
  window.addEventListener(CART_CHANGED_EVENT, updateCartBadge);
  // Cross-tab updates (cart changed in another open tab/window).
  window.addEventListener('storage', (e) => {
    if (e.key === null || e.key === 'safari-meats-cart') updateCartBadge();
  });

  // Mobile menu toggle.
  const menuButton = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  menuButton?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    menuButton.setAttribute('aria-expanded', String(!!isHidden));
  });

  // Close the mobile menu when a nav link is tapped.
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
    });
  });

  // Theme toggle (desktop + mobile buttons share this handler).
  const THEME_KEY = 'safari-meats-theme';

  const themeColorMeta = document.getElementById('theme-color-meta');

  function setTheme(theme: 'dark' | 'light') {
    if (theme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    // Set instantly (no CSS transition applies to a meta tag), so the
    // browser gets the final color right away instead of trying to
    // interpolate/re-sample it across the 0.3s background-color fade.
    themeColorMeta?.setAttribute('content', theme === 'light' ? '#fbf8f2' : '#0b0c0e');
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch (e) {}
  }

  // Re-bind on every client-side navigation, not just the first load — see
  // the astro:page-load comment in contact.astro for why this is needed
  // with astro:transitions. The header is transition:persist'd, so its
  // buttons are the *same* DOM nodes across navigations rather than fresh
  // ones — guard with a data attribute so we don't double-bind and end up
  // toggling twice per click.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.theme-toggle').forEach((btn) => {
      if (btn.hasAttribute('data-theme-bound')) return;
      btn.setAttribute('data-theme-bound', 'true');
      btn.addEventListener('click', () => {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        setTheme(isLight ? 'dark' : 'light');
      });
    });
  });

  // Contact FAB: expand/collapse the Call/WhatsApp options. Bound once
  // (transition:persist keeps this the same DOM node across navigations,
  // same reasoning as the theme toggle above) and closes on outside click,
  // Escape, or picking an option.
  document.addEventListener('astro:page-load', () => {
    const trigger = document.getElementById('contact-fab-trigger');
    if (!trigger || trigger.hasAttribute('data-fab-bound')) return;
    trigger.setAttribute('data-fab-bound', 'true');

    const options = document.getElementById('contact-fab-options');
    const iconOpenSvg = document.getElementById('fab-icon-open');
    const iconCloseSvg = document.getElementById('fab-icon-close');

    function setOpen(open: boolean) {
      options?.classList.toggle('fab-open', open);
      iconOpenSvg?.classList.toggle('hidden', open);
      iconCloseSvg?.classList.toggle('hidden', !open);
      trigger?.setAttribute('aria-expanded', String(open));
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!options?.classList.contains('fab-open'));
    });

    document.addEventListener('click', (e) => {
      const fab = document.getElementById('contact-fab');
      if (fab && !fab.contains(e.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    options?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  });
</script>
