---
// Site-wide shell: nav + footer, per proposal section 2.11.
import { getEntry } from 'astro:content';
import { ViewTransitions } from 'astro:transitions';
import type { TransitionAnimationValue } from 'astro:transitions';
import '../styles/global.css';

// Fluid page-content transition: outgoing page eases down/out, incoming page
// eases up/in, on matching curves so the swap reads as one continuous motion.
// Keyframes for these live in the global <style> block below. Only the
// #page-content wrapper uses this — header/footer are transition:persist'd
// and never animate. Same animation runs for forwards and backwards nav.
const pageContentPair = {
  old: {
    name: 'page-content-out',
    duration: '0.28s',
    easing: 'cubic-bezier(0.4, 0, 1, 1)',
    fillMode: 'both',
  },
  new: {
    name: 'page-content-in',
    duration: '0.42s',
    easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
    fillMode: 'both',
  },
};

const pageTransition: TransitionAnimationValue = {
  forwards: pageContentPair,
  backwards: pageContentPair,
};

interface Props {
  title: string;
}

const { title } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/products', label: 'Products' },
  { href: '/wholesale', label: 'Wholesale' },
  { href: '/contact', label: 'Contact' },
  { href: '/quote', label: 'Request a Quote' },
];

const footerLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/products', label: 'Products' },
  { href: '/wholesale', label: 'Wholesale' },
  { href: '/quote', label: 'Request a Quote' },
  { href: '/contact', label: 'Contact' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Safari Meat Exports</title>

    <!-- Enables smooth, SPA-style page transitions for every internal link
         on the site (astro:transitions). No per-page setup needed. -->
    <ViewTransitions />

    <!--
      Theme tokens: two brand palettes (not literal black/white) toggled via
      [data-theme] on <html>. Dark is the default (no attribute needed) so
      first-time visitors get dark mode with zero JS/flash. Alpha variants
      throughout the site are expressed with color-mix() against these two
      base colors, so every /NN opacity used on a page carries over exactly
      to whichever theme is active instead of needing a light AND dark
      version of every shade.

      Palette: neutral-950/neutral-100 dark, neutral-50/neutral-900 light,
      amber accent (500 on dark, 600 on light for contrast).
    -->
    <style is:global>
      :root {
        --color-bg: #0a0a0a;              /* neutral-950 */
        --color-bg-soft: #171717;         /* neutral-900 */
        --color-bg-soft-2: #262626;       /* neutral-800 */
        --color-text: #f5f5f5;            /* neutral-100 */
        --color-accent: #f59e0b;          /* amber-500 */
        --color-accent-contrast: #0a0a0a; /* text sitting on accent bg */
        color-scheme: dark;
      }

      :root[data-theme='light'] {
        --color-bg: #fafafa;              /* neutral-50 */
        --color-bg-soft: #f5f5f5;         /* neutral-100 */
        --color-bg-soft-2: #e5e5e5;       /* neutral-200 */
        --color-text: #171717;            /* neutral-900 */
        --color-accent: #d97706;          /* amber-600 */
        --color-accent-contrast: #0a0a0a;
        color-scheme: light;
      }

      html {
        background-color: var(--color-bg);
      }

      body {
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      .theme-icon-sun {
        display: none;
      }
      .theme-icon-moon {
        display: block;
      }
      [data-theme='light'] .theme-icon-sun {
        display: block;
      }
      [data-theme='light'] .theme-icon-moon {
        display: none;
      }

      /*
        Keyframes referenced by `pageTransition` above (applied to
        #page-content via transition:animate). Astro generates the scoped
        ::view-transition-old/new(page-content) rules that point at these
        names, so we only need to define the motion itself here.
      */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }

      @keyframes page-content-out {
        from {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
        to {
          opacity: 0;
          transform: translateY(-8px) scale(0.99);
        }
      }

      @keyframes page-content-in {
        from {
          opacity: 0;
          transform: translateY(14px) scale(0.99);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }
    </style>

    <!-- Blocking: applies a saved "light" preference before first paint. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('safari-meats-theme');
          if (stored === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text)]">
    <header
      transition:persist
      transition:name="site-header"
      class="sticky top-0 z-50 border-b border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_80%,transparent)] backdrop-blur-md">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" class="flex items-center gap-2 text-[var(--color-text)]">
          <span class="text-lg font-bold tracking-tight">
            Safari<span class="text-[var(--color-accent)]">Meat</span>
          </span>
          <span class="hidden text-xs uppercase tracking-[0.2em] text-[color-mix(in_srgb,var(--color-text)_45%,transparent)] sm:inline">
            Exports
          </span>
        </a>

        <!-- Desktop nav -->
        <div class="hidden items-center gap-1 lg:flex">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-[color-mix(in_srgb,var(--color-text)_70%,transparent)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)] hover:text-[var(--color-text)]"
            >
              {link.label}
            </a>
          ))}

          <button
            type="button"
            class="theme-toggle ml-1 inline-flex h-9 w-9 items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)]"
            aria-label="Toggle color theme"
          >
            <svg class="theme-icon-sun h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.36 6.36l-1.06-1.06M6.7 6.7 5.64 5.64m12.72 0-1.06 1.06M6.7 17.3l-1.06 1.06M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z" />
            </svg>
            <svg class="theme-icon-moon h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
            </svg>
          </button>

          <a
            href="/order"
            class="ml-2 inline-flex items-center gap-1.5 rounded-lg bg-[var(--color-accent)] px-3.5 py-2 text-sm font-semibold text-[var(--color-accent-contrast)] transition hover:brightness-110"
          >
            Your Order
            <span
              id="nav-cart-count"
              class="inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-black/20 px-1.5 py-0.5 text-xs font-bold"
            >
              0
            </span>
          </a>
        </div>

        <!-- Mobile controls -->
        <div class="flex items-center gap-2 lg:hidden">
          <button
            type="button"
            class="theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)]"
            aria-label="Toggle color theme"
          >
            <svg class="theme-icon-sun h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.36 6.36l-1.06-1.06M6.7 6.7 5.64 5.64m12.72 0-1.06 1.06M6.7 17.3l-1.06 1.06M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z" />
            </svg>
            <svg class="theme-icon-moon h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
            </svg>
          </button>

          <a
            href="/order"
            class="inline-flex items-center gap-1.5 rounded-lg bg-[var(--color-accent)] px-3 py-1.5 text-sm font-semibold text-[var(--color-accent-contrast)]"
          >
            Order
            <span
              id="nav-cart-count-mobile"
              class="inline-flex min-w-[1.1rem] items-center justify-center rounded-full bg-black/20 px-1.5 py-0.5 text-xs font-bold"
            >
              0
            </span>
          </a>
          <button
            id="mobile-menu-button"
            type="button"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)]"
          >
            <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] lg:hidden">
        <div class="space-y-0.5 px-4 py-3 sm:px-6">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="block rounded-md px-3 py-2.5 text-sm font-medium text-[color-mix(in_srgb,var(--color-text)_70%,transparent)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_6%,transparent)] hover:text-[var(--color-text)]"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </header>

    <div id="page-content" transition:animate={pageTransition} transition:name="page-content">
      <slot />
    </div>

    <footer
      transition:persist
      transition:name="site-footer"
      class="border-t border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[var(--color-bg)]">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
        <div class="grid gap-10 sm:grid-cols-3">
          <div>
            <span class="text-lg font-bold tracking-tight text-[var(--color-text)]">
              Safari<span class="text-[var(--color-accent)]">Meat</span>
            </span>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-[color-mix(in_srgb,var(--color-text)_55%,transparent)]">
              East African meat sourcing and export, built on quality, professional
              handling, and reliable supply relationships.
            </p>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
              Explore
            </h3>
            <nav class="mt-4 flex flex-col gap-2.5">
              {footerLinks.map((link) => (
                <a
                  href={link.href}
                  class="text-sm text-[color-mix(in_srgb,var(--color-text)_55%,transparent)] transition hover:text-[var(--color-accent)]"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
              Your Order
            </h3>
            <a
              href="/order"
              class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-[color-mix(in_srgb,var(--color-text)_15%,transparent)] bg-[color-mix(in_srgb,var(--color-text)_4%,transparent)] px-3.5 py-2 text-sm font-medium text-[var(--color-text)] transition hover:bg-[color-mix(in_srgb,var(--color-text)_8%,transparent)]"
            >
              View Order
              <span
                id="nav-cart-count-footer"
                class="inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-[color-mix(in_srgb,var(--color-accent)_20%,transparent)] px-1.5 py-0.5 text-xs font-bold text-[var(--color-accent)]"
              >
                0
              </span>
            </a>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-4 border-t border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
            &copy; {new Date().getFullYear()} Safari Meats — East African Meat Exporters
          </p>
          <div class="flex gap-5 text-xs text-[color-mix(in_srgb,var(--color-text)_45%,transparent)]">
            <!-- <a href="/privacy" class="transition hover:text-[color-mix(in_srgb,var(--color-text)_70%,transparent)]">Privacy Policy</a> -->
            <!-- <a href="/terms" class="transition hover:text-[color-mix(in_srgb,var(--color-text)_70%,transparent)]">Terms &amp; Conditions</a> -->
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  // Keeps the "Your Order (N)" badge in the header/footer nav in sync with
  // the cart on every page, not just the order page itself. cartCount() was
  // previously exported from cart.ts but never called anywhere — this is
  // that call site.
  import { getCart, cartCount, CART_CHANGED_EVENT } from '../lib/cart';

  function updateCartBadge() {
    const count = cartCount(getCart());
    for (const id of ['nav-cart-count', 'nav-cart-count-mobile', 'nav-cart-count-footer']) {
      const el = document.getElementById(id);
      if (el) el.textContent = String(count);
    }
  }

  updateCartBadge();

  // Same-tab updates (adding an item, editing qty on the order page, etc.)
  window.addEventListener(CART_CHANGED_EVENT, updateCartBadge);
  // Cross-tab updates (cart changed in another open tab/window).
  window.addEventListener('storage', (e) => {
    if (e.key === null || e.key === 'safari-meats-cart') updateCartBadge();
  });

  // Mobile menu toggle.
  const menuButton = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  menuButton?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    menuButton.setAttribute('aria-expanded', String(!!isHidden));
  });

  // Close the mobile menu when a nav link is tapped.
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
    });
  });

  // Theme toggle (desktop + mobile buttons share this handler).
  const THEME_KEY = 'safari-meats-theme';

  function setTheme(theme: 'dark' | 'light') {
    if (theme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch (e) {}
  }

  document.querySelectorAll('.theme-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      setTheme(isLight ? 'dark' : 'light');
    });
  });
</script>
